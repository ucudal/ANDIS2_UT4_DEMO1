# ---------------------------------------------------------------------------
# Levantar todos los servicios
# ---------------------------------------------------------------------------

# Estos comandos deben ejecutarse desde la raíz del repositorio. Usar el comando
# 'Azure CLI: Run Line in Terminal'.

# Inicia Docker si no está iniciado
docker desktop start

# Crear las carpetas que serán montadas como volúmenes para contener las bases
# de datos
mkdir -p UsersService/pgdata
mkdir -p ProductsService/mongodbdata
mkdir -p OrdersService/mysqldata

# Levantar todos los contenedores
docker compose build
docker compose up -d --wait

# ---------------------------------------------------------------------------
# Probar los servicios a través del API Gateway
# ---------------------------------------------------------------------------

# Seleccionar y ejecutar esta función en la terminal de la misma forma como se
# ejecutan los demás comandos de este archivo -o definirla en ~/.zshrc o
# ~/.bashrc para tenerla siempre-. Es una ayuda para ver las respuestas de los
# comandos 'curl' que son JSON como tabla, definir Requiere jq y column; ver los
# requisitos en README.md. Una lista de objetos se muestra con una columna por
# campo, y un objeto solo, como pares clave-valor. Para ver el resultado en JSON
# seleccionar sólo el comando 'curl' hasta antes del pipe '|'.
table() {
  jq -r 'if type == "array"
         then (.[0] | keys_unsorted) as $k | ($k | @tsv), (.[] | [.[$k[]] | tostring] | @tsv)
         else to_entries[] | [.key, (.value | tostring)] | @tsv end' \
  | column -t -s $'\t'
}

# Users expone SOAP en lugar de REST. Comparado con Products:
# - Hay un único endpoint, /users/UserService.svc, y todas las operaciones son
#   POST, incluso las que solo leen. La operación no está en la URL ni en el
#   método HTTP: va en el encabezado SOAPAction y en el elemento del sobre.
# - El cuerpo es un sobre XML con namespaces, que hay que escribir completo.
# - El contrato se publica como WSDL.
# - Los errores son SOAP Faults, que viajan siempre como HTTP 500.

# Ver el contrato de Users
curl -s "http://localhost/users/UserService.svc?wsdl" | xmllint --format -

# Obtener todos los usuarios
curl -s -X POST http://localhost/users/UserService.svc \
  -H "Content-Type: text/xml; charset=utf-8" \
  -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/ListUsers"' \
  -d '<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
        <soap:Body>
          <ListUsers xmlns="http://ucu.edu.uy/andis/users" />
        </soap:Body>
      </soap:Envelope>' | xmllint --format -

# Agregar un nuevo usuario. El email es único: si el comando se ejecuta dos
# veces, la segunda responde HTTP 500 con un SOAP Fault que explica el motivo;
# para crear otro usuario, cambiar el email.
curl -s -X POST http://localhost/users/UserService.svc \
  -H "Content-Type: text/xml; charset=utf-8" \
  -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/CreateUser"' \
  -d '<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
        <soap:Body>
          <CreateUser xmlns="http://ucu.edu.uy/andis/users">
            <name>julia</name>
            <email>julia@example.com</email>
          </CreateUser>
        </soap:Body>
      </soap:Envelope>' | xmllint --format -

# Buscar un usuario. Si no existe, la respuesta llega con HTTP 200 y sin
# GetUserResult, no con un Fault.
curl -s -X POST http://localhost/users/UserService.svc \
  -H "Content-Type: text/xml; charset=utf-8" \
  -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/GetUser"' \
  -d '<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
        <soap:Body>
          <GetUser xmlns="http://ucu.edu.uy/andis/users">
            <id>1</id>
          </GetUser>
        </soap:Body>
      </soap:Envelope>' | xmllint --format -

# Cambiar un usuario. Users publica el evento user.updated, y la vista
# materializada de Orders actualiza el nombre del cliente.
curl -s -X POST http://localhost/users/UserService.svc \
  -H "Content-Type: text/xml; charset=utf-8" \
  -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/UpdateUser"' \
  -d '<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
        <soap:Body>
          <UpdateUser xmlns="http://ucu.edu.uy/andis/users">
            <id>1</id>
            <name>alice</name>
            <email>alice@example.com</email>
          </UpdateUser>
        </soap:Body>
      </soap:Envelope>' | xmllint --format -

# Obtener todos los productos
curl -s http://localhost/products/ | table

# Agregar un producto
curl -s -X POST http://localhost/products/ \
  -H "Content-Type: application/json" \
  -d '{"name": "Buzo", "price": 2300.00}' | jq

# Buscar un producto. La primera vez lo lee de MongoDB y lo guarda en Redis;
# las siguientes, durante 60 segundos, lo lee de Redis -Cache-Aside-.
curl -s http://localhost/products/60f7c2b5e1d3c2a1b8e4d123 | jq

# Cambiar un producto. Products borra el producto de Redis y publica el evento
# product.updated.
curl -s -X PUT http://localhost/products/60f7c2b5e1d3c2a1b8e4d123 \
  -H "Content-Type: application/json" \
  -d '{"name": "Camisa", "price": 1200.50}' | jq

# Obtener todas las órdenes
curl -s http://localhost/orders/ | table

# Crear una nueva orden -Asynchronous Request-Reply-. Orders no procesa la
# orden en el momento: la guarda como Pending y responde enseguida con
# 202 Accepted, que significa "recibí el pedido, pero todavía no está listo".
# La respuesta trae dos encabezados que le dicen al cliente cómo seguir:
# - Location: la dirección donde consultar el estado, /orders/{id}/status.
# - Retry-After: cuántos segundos esperar antes de consultarla, 2.
# Un worker procesa la orden después, en segundo plano. Con -i, curl incluye
# los encabezados en la respuesta. La respuesta se guarda en una variable para
# mostrarla y para sacar de ella la dirección de Location, que usan los
# comandos siguientes.
response=$(curl -s -i -X POST http://localhost/orders/ \
  -H "Content-Type: application/json" \
  -d '{"userId": 2, "productId": "60f7c2b5e1d3c2a1b8e4d124", "quantity": 2}')
echo "$response"
location=$(echo "$response" | grep -i '^location:' | tr -d '\r' | awk '{print $2}')
echo "$location"

# Consultar el estado de la orden en la dirección que indicó Location, igual
# que haría un cliente. La respuesta depende de si el worker ya la procesó:
# - Si todavía está Pending, responde 200 con el estado y otra vez
#   Retry-After: el cliente tiene que volver a consultar más tarde.
# - Si ya la confirmó o la rechazó, responde 303 See Other, sin cuerpo, con
#   Location apuntando a la orden, /orders/{id}: el resultado está ahí.
# Una orden nueva tarda unos 3 segundos en procesarse: si se consulta enseguida
# se ve el 200, y repitiendo la consulta unos segundos después, el 303.
curl -s -i "http://localhost$location"

# Lo mismo, pero con -L curl sigue la redirección del 303 por su cuenta y
# muestra directamente la orden, con su estado final.
curl -s -L "http://localhost$location" | jq

# Obtener las órdenes de un usuario y sus detalles, pidiendo los nombres a
# Users y a Products
curl -s http://localhost/orders/user/1/details | table

# Lo mismo, leído de la vista materializada -CQRS-
curl -s http://localhost/orders/user/1/details/view | table

# Obtener los eventos de una orden -Event Sourcing- y el estado que resulta de
# reproducirlos. La respuesta tiene las dos partes: se muestra cada una como
# tabla por separado.
curl -s http://localhost/orders/1/events | jq .events | table
curl -s http://localhost/orders/1/events | jq .replayed_state | table

# Ver la salud de cada servicio -Health Endpoint Monitoring-. La respuesta tiene
# objetos anidados, que se leen mejor con jq que como tabla.
curl -s http://localhost/health/users | jq .
curl -s http://localhost/health/products | jq .
curl -s http://localhost/health/orders | jq .

# ---------------------------------------------------------------------------
# Observabilidad -opcional, recomendada para las demos-
# ---------------------------------------------------------------------------

# Levantar también Prometheus y Grafana. Si la aplicación ya está levantada,
# solo agrega los dos contenedores nuevos.
docker compose --profile observability up -d --wait

# Abrir en el navegador el dashboard de Grafana. Tiene los paneles que se
# mencionan en cada demo:
#
#    http://localhost:3000
#
# No pide usuario ni contraseña, y el dashboard es la página de inicio de
# Grafana, así que aparece directamente. Grafana
# lo carga al arrancar desde observability/grafana/dashboards/andis-demo.json;
# no hay que importarlo. Conviene dejarlo abierto durante todas las demos; se
# actualiza cada 5 segundos.
#
# Al final del título de cada panel, entre corchetes, están las demos que lo
# usan, por el número de su script en 'demos/': [Demo 1] es 01-retry.sh, y
# [Demos 1-3, 16] son 01, 02, 03 y 16. En los textos de este archivo los
# paneles se nombran sin ese agregado.
#
# Prometheus y el estado de cada target:
#
#     http://localhost:9090/targets
#
# Métricas de un servicio, tal como las lee Prometheus

curl http://localhost:8000/metrics

# ---------------------------------------------------------------------------
# Demos de los patrones
# ---------------------------------------------------------------------------

# Cada patrón tiene un script en la carpeta 'demos/' que lo muestra paso a paso,
# con pocas solicitudes; la evidencia en los logs de Docker se ve con los
# comandos de este archivo. Los que dependen de la carga tienen además un
# escenario de k6 en la carpeta 'k6/', para verlos en Grafana a lo largo del
# tiempo. Los scripts y escenarios inyectan las fallas que
# necesitan y las quitan al terminar.
#
# Para que cada demo muestre un solo patrón, las de Retry, Circuit Breaker,
# Bulkhead y Throttling dejan prendido en Orders solo el suyo y apagan los
# demás; al terminar, los vuelven a prender. Así, en la demo de Retry no se abre
# el circuito, y en la de Throttling no actúa el Bulkhead. En Grafana, el panel
# "Patrones de resiliencia prendidos en Orders" muestra cuáles estaban prendidos
# en cada momento. También se pueden prender y apagar a mano, sin reiniciar:

curl -s http://localhost/orders/patterns | jq
curl -s -X PUT http://localhost/orders/patterns -H "Content-Type: application/json" \
  -d '{"retry": true, "circuitBreaker": false, "bulkhead": false, "throttling": false}' | jq
curl -s -X DELETE http://localhost/orders/patterns | jq

# Mientras corren, se puede tener abierto en otras terminales:
# 1. Los logs de Docker de Orders, donde cada patrón deja su etiqueta: [RETRY],
#    [CIRCUIT BREAKER], [BULKHEAD], [THROTTLING], [COMPETING CONSUMERS] y
#    [OUTBOX]; y, para los patrones de rendimiento, los de orders-projector y
#    products-service: [PUB/SUB], [MATERIALIZED VIEW] y [CACHE-ASIDE]

    docker compose logs -f --since 1s orders-service orders-worker
    docker compose logs -f --since 1s orders-projector products-service

# 2. La salud de los servicios en vivo

    ./demos/monitor-health.sh

# ----------------
# --- 01 Retry ---
# ----------------
# El detalle de las Orders de un User lo arma Orders: lee las Orders en su base
# y, para completarlas, le pide a Users el nombre del cliente y a Products el
# nombre del producto de cada Order; en caso de que Users o Products no estén
# disponbibles, muestra 'no disponible' en lugar del nombre del cliente o del
# producto, respectivamente. Cada consulta hace 1 llamada a Users y 1 a Products
# por cada Order. Sin fallas, la respuesta trae una entrada por Order con el
# nombre del cliente y el nombre del producto:

curl -s http://localhost/orders/user/1/details | table

# Configurar Products para que falle 100% de las veces, ejecutar nuevamente la
# consulta /orders/users/{id}/detals, y comparar el resultado con el anterior:

curl -s -X PUT http://localhost/products/chaos \
  -H 'Content-Type: application/json' \
  -d "{\"failureRate\": 1, \"delayMs\": 0}"

curl -s http://localhost/orders/user/1/details | table

# Reparar Products, configurar Users para que falle 100% de las veces, ejecutar
# nuevamente la consulta /orders/user/{id}/detals, y comparar con el resultado
# anterior:

curl -s -X DELETE http://localhost/products/chaos

curl -s -X PUT http://localhost/users/chaos \
  -H 'Content-Type: application/json' \
  -d "{\"failureRate\": 1, \"delayMs\": 0}" | jq

curl -s http://localhost/orders/user/1/details | table

# Restaurar Users

curl -s -X DELETE http://localhost/users/chaos | jq

# Apagar el patrón Retry -y los demás- y hacer que Products y Users fallen el
# 30% de las veces. Luego ejecutar varias veces la consulta a
# orders/user/{id}/detail. Debería aparecer a veces 'no disponible [error HTTP
# 503]' en lugar del nombre del usuario o de los productos.

curl -s -X PUT http://localhost/orders/patterns \
  -H "Content-Type: application/json" \
  -d '{"retry": false, "circuitBreaker": false, "bulkhead": false, "throttling": false}' | jq

curl -s -X PUT http://localhost/products/chaos \
  -H 'Content-Type: application/json' \
  -d "{\"failureRate\": 0.3, \"delayMs\": 0}" | jq

curl -s -X PUT http://localhost/users/chaos \
  -H 'Content-Type: application/json' \
  -d "{\"failureRate\": 0.3, \"delayMs\": 0}" | jq

curl -s http://localhost/orders/user/1/details | table

# Prender el patrón Retry solamente y nuevamente ejecutar varias veces la
# consulta a orders/user/{id}/details. Ahora el nombre del usuario y de los
# productos debería aparecer siempre, excepto que falle todas las veces que se
# reintente, hasta desistir. Cuando hay reintentos, la consulta demora más.

curl -s -X PUT http://localhost/orders/patterns \
  -H "Content-Type: application/json" \
  -d '{"retry": true, "circuitBreaker": false, "bulkhead": false, "throttling": false}' | jq

curl -s http://localhost/orders/user/1/details | table

# Prender el resto de los patrones y reparar Products y Users.

curl -s -X DELETE http://localhost/orders/patterns
curl -s -X DELETE http://localhost/products/chaos
curl -s -X DELETE http://localhost/users/chaos

# El siguiente script hace lo mismo, solo con Products: lo hace fallar en el
# 30 % de las solicitudes y repite la consulta 8 veces, una por segundo, con
# todos los patrones apagados; después prende solo el Retry y la repite otras 8
# veces. Tarda unos 20 segundos.

./demos/01-retry.sh

# Resultado en consola: cada consulta muestra al final el código HTTP y el
# tiempo de respuesta:
# - Con el Retry apagado, cada llamada fallida queda fallida: con las dos Orders
#   de los datos iniciales, cerca de la mitad de las consultas trae algún
#   producto "no disponible [error HTTP 503]". Todas responden en milisegundos.
# - Con el Retry prendido, Orders reintenta cada llamada fallida hasta 3 veces;
#   como la falla es transitoria, casi siempre funciona y la respuesta trae el
#   nombre del producto. Si se agotaran los reintentos, diría "no disponible".
#   Las que demoran más son las que necesitaron reintentos: 0.5, 1 o 2
#   segundos, con jitter.
# El Circuit Breaker queda apagado tanto con Retry prendido como con Retry
# apagado: con 30 % de fallas podría abrirse en una mala racha, y la consulta
# diría "no disponible [circuito abierto]", lo que mezclaría los dos patrones.

# Logs de Docker: una línea [RETRY] por reintento, con el número de reintento,
# la espera y la causa -HTTP 503-, solo en la segunda mitad.

docker compose logs orders-service | grep '\[RETRY\]'

# Resultado en Grafana: la demo dura unos 20 segundos, así que las señales son
# breves:
# - "Patrones de resiliencia prendidos en Orders": los cuatro en 0 durante la
#   primera mitad; en la segunda, Retry sube a 1.
# - "Eventos de resiliencia": barras amarillas "products · OnRetry", con la
#   cantidad de reintentos de cada intervalo de 5 segundos, solo en la segunda
#   mitad.
# - "Fracción de solicitudes que fallan a propósito": products-service sube a
#   30 % mientras dura la demo.

# --------------------------
# --- 02 Circuit Breaker ---
# --------------------------
# Al igual que en la demo de Retry, se consulta el detalle de las Orders del
# User 1, que Orders completa pidiéndole a Products el nombre del producto de
# cada Order. Pero ahora Products falla siempre: reintentar no sirve, y seguir
# llamándolo solo demora las respuestas y lo sobrecarga justo cuando intenta
# recuperarse. Orders tiene un circuito por dependencia: si fallan al menos la
# mitad de las llamadas en 10 segundos, con un mínimo de 5, el circuito se abre
# y durante 15 segundos las llamadas fallan de inmediato, sin llegar a Products.
# Después de 15 segundos pasa a semiabierto: deja pasar una llamada de prueba y,
# si funciona, se cierra.
#
# El siguiente script hace que Products falle en el 100 % de las solicitudes y
# consulta el detalle 6 veces con todos los patrones apagados; después prende
# solo el Circuit Breaker y lo consulta otras 6 veces. Después de cada tanda
# dice cuántas llamadas le llegaron a Products, según las métricas de Products.
# Al final hace que Products se recupere y espera a que el circuito se cierre.
# Tarda unos 25 segundos.

./demos/02-circuit-breaker.sh

# Resultado en consola:
# - Con el Circuit Breaker apagado, las 6 consultas dicen "no disponible [error
#   HTTP 503]" en los dos productos, y Products recibe 12 llamadas, 2 por
#   consulta: Orders lo sigue llamando aunque falle siempre.
# - Con el Circuit Breaker prendido, el Retry sigue apagado, así que cada
#   llamada a Products falla una sola vez y cuenta una vez para el circuito.
#   Las dos primeras consultas dicen "no disponible [error HTTP 503]": Orders
#   llamó a Products y falló. En la tercera se llega a 5 fallas y el circuito
#   se abre: su segundo producto ya dice "no disponible [circuito abierto]".
#   Desde ahí, las consultas dicen "no disponible [circuito abierto]" en los
#   dos productos: Orders ya no llama a Products, que recibe solo 5 llamadas.
# Cuando Products se recupera, la respuesta sigue degradada, porque el circuito
# queda abierto 15 segundos aunque Products ya funcione. Pasado ese tiempo, la
# llamada de prueba funciona, el circuito se cierra y vuelve el nombre del
# producto. Todas responden en milisegundos.
#
# Con el Retry prendido la primera consulta demoraría unos segundos: cada
# llamada se reintentaría hasta 3 veces antes de que se abriera el circuito, y
# cada reintento contaría como una falla más.

# Logs de Docker: circuito ABIERTO, SEMIABIERTO y CERRADO, en ese orden.

docker compose logs orders-service | grep '\[CIRCUIT BREAKER\]'

# Grafana:
# - "Patrones de resiliencia prendidos en Orders": los cuatro en 0 durante la
#   primera tanda; desde la segunda, Circuit Breaker sube a 1.
# - "Estado del circuito de cada dependencia": Products y Users en gris,
#   apagado, durante la primera tanda; como dura pocos segundos, es una franja
#   angosta. Después, Products pasa a rojo, abierto,
#   durante 15 segundos, y vuelve a verde, cerrado. El semiabierto dura lo que
#   tarda la llamada de prueba, milisegundos, y no llega a verse. Users queda
#   en verde.
# - "Eventos de resiliencia": una barra de altura 1 para cada evento:
#   OnCircuitOpened en rojo cuando se abre el circuito, y unos 15 segundos
#   después, OnCircuitClosed en verde con OnCircuitHalfOpened en naranja
#   apilada encima, porque ocurren en el mismo intervalo de 5 segundos.

# Bajo carga: 5 consultas por segundo durante 80 segundos; Products falla entre
# los 15 y los 50 segundos.

docker compose run --rm k6 run /scripts/circuit-breaker.js

# Resultado en la consola: todos los checks "status 200" pasan;
# degraded_responses indica qué fracción de las respuestas llegó degradada.
#
# En Grafana:
# - "Patrones de resiliencia prendidos en Orders": solo circuit breaker queda en
#   1; sin Retry, no hay barras OnRetry.
# - "Eventos de resiliencia": una barra de altura 1 para cada evento; los que
#   ocurren en el mismo intervalo de 5 segundos se apilan. Al empezar la falla,
#   OnCircuitOpened en rojo. Como la falla dura 35 segundos, más que los 15 que
#   el circuito queda abierto, cada 15 segundos aparecen apiladas
#   OnCircuitHalfOpened en naranja y otra vez OnCircuitOpened: la llamada de
#   prueba falló. Pasa dos o tres veces, según cuándo cae la prueba. Después de
#   la recuperación, OnCircuitHalfOpened y OnCircuitClosed en verde.
# - "Estado del circuito de cada dependencia": Products en verde, cerrado,
#   hasta unos segundos después de empezar la falla; en rojo, abierto, de
#   corrido mientras dura la falla y hasta 15 segundos después, porque cada
#   prueba fallida lo vuelve a abrir; y otra vez en verde. Users sigue en verde
#   todo el tiempo.
# - "Resultado de las llamadas a cada dependencia": al empezar la falla aparece
#   "products · HTTP 503" por unos segundos, hasta que el circuito se abre;
#   desde ahí "products · BrokenCircuit" la reemplaza, y "products · HTTP 200"
#   baja a 0. Después de la recuperación vuelve "products · HTTP 200".
# - "Solicitudes por segundo, por código HTTP": el cliente sigue recibiendo 200
#   todo el tiempo.
# - "Usuarios virtuales y respuestas degradadas": el % degradado sube durante la
#   falla hasta cerca de 70 % y baja de a poco después: es la fracción acumulada
#   desde el inicio del escenario, así que no vuelve a 0.

# -------------------
# --- 03 Bulkhead ---
# -------------------
# Al igual que en la demo de Retry, se consulta el detalle de las Orders del
# User 1, que Orders completa pidiéndole a Users el nombre del cliente y a
# Products el nombre del producto de cada Order. Si Products se pone lento, las
# llamadas pendientes se acumulan y consumen los recursos -conexiones, memoria,
# hilos- que también necesitan las llamadas a Users. Para evitarlo, Orders
# limita cuántas llamadas puede tener a la vez con cada dependencia, en
# compartimentos separados: Products tiene 5 llamadas en curso y 5 en espera, y
# Users 20 en curso y 5 en espera.
#
# Cada compartimento funciona como un semáforo con fila. Si hay un lugar libre,
# la llamada lo toma, sale hacia la dependencia y lo libera al terminar. Si no
# hay lugar pero queda espacio en la fila, espera; cuando se libera un lugar,
# entra la primera de la fila. Si los lugares y la fila están llenos, la llamada
# se rechaza de inmediato, sin llegar a la red, y la respuesta dice "no
# disponible [bulkhead lleno]" en lugar del nombre. El compartimento es lo
# primero que atraviesa cada llamada, antes que Retry y Circuit Breaker: un
# lugar cubre la llamada completa, reintentos incluidos.
#
# El siguiente script apaga todos los patrones, hace algunas rondas de
# consultas para que los servicios tengan abiertas sus conexiones, hace que
# Products demore 1.5 segundos en cada solicitud y lanza 15 consultas de detalle
# simultáneas. Después prende solo el Bulkhead y lanza otras 15. Mientras corre
# cada tanda, mide cuántas llamadas atiende Products a la vez, según las
# métricas de Products. Tarda unos 25 segundos.

./demos/03-bulkhead.sh

# Resultado en consola: en cada tanda, una fila por consulta, ordenadas por
# tiempo de respuesta, y un resumen. El User 1 tiene 2 Orders, así que cada
# consulta hace 2 llamadas a Products, de a una y de 1.5 segundos cada una.
#
# Con el Bulkhead apagado, las 15 consultas traen todos los nombres y demoran
# 3 segundos, 2 llamadas de 1.5 segundos; pero Products llega a atender 15
# llamadas a la vez: Orders le manda todas las que recibe. Con 15 consultas
# Products las atiende, pero con 1.000 se quedaría sin conexiones, y Orders
# acumularía 1.000 llamadas pendientes que ocupan los recursos que también
# necesitan las llamadas a Users.
#
# Con el Bulkhead prendido, Products nunca atiende más de 5 llamadas a la vez.
# El costo: 5 consultas se rechazan y otras demoran más. Si se llama A a las 5
# primeras consultas, B a las 5 siguientes y C a las últimas 5:
# - 0 segundos: A toma los 5 lugares y B ocupa la fila. C encuentra todo
#   lleno y se rechaza; su otra llamada también, porque el compartimento sigue
#   lleno, así que C termina en milisegundos con los dos productos "no
#   disponible [bulkhead lleno]".
# - 1.5 segundos: A termina su primera llamada y libera los lugares, que toma
#   B, la primera en la fila. A pide su segunda llamada y va a la fila.
# - 3 segundos: B termina su primera llamada; A entra con la segunda y B va a
#   la fila.
# - 4.5 segundos: A termina su segunda llamada, y con ella la consulta; B entra
#   con la segunda.
# - 6 segundos: B termina. A demora 4.5 segundos y no 3, como serían 2 llamadas
#   de 1.5 segundos, porque se turna con B por los 5 lugares. A y B traen todos
#   los nombres de los productos.
# En las dos tandas el nombre del cliente aparece en todas: Users tiene su
# propio compartimento de 20 lugares, entran las 15 consultas y no compite con
# Products por nada.

# Logs de Docker: líneas [BULKHEAD] solo para Products, solo en la segunda
# tanda.

docker compose logs orders-service | grep '\[BULKHEAD\]'

# Grafana: entre las dos tandas el script espera 10 segundos, para que se
# distingan:
# - "Patrones de resiliencia prendidos en Orders": los cuatro en 0 durante la
#   primera tanda; en la segunda, bulkhead sube a 1.
# - "Eventos de resiliencia": OnRateLimiterRejected en violeta, solo en la
#   segunda tanda: 10 rechazos, las 2 llamadas de cada una de las 5 consultas C.
# - "Resultado de las llamadas a cada dependencia": en la primera tanda, solo
#   "products · HTTP 200"; en la segunda aparece "products · RateLimiterRejected".
#   "users · HTTP 200" en las dos, sin rechazos.
# - "Duración de las llamadas a cada dependencia, p95": Products en unos 2
#   segundos en la primera tanda y en unos 4.5 en la segunda, porque incluye el
#   tiempo que la llamada espera en la fila. Users en milisegundos en las dos.

# Bajo carga: 6 consultas por segundo durante 45 s, con Products lento.

docker compose run --rm k6 run /scripts/bulkhead.js

# Resultado en consola: todos los checks pasan; cerca del 70 % de las respuestas
# llegan degradadas.
#
# Resultado en Grafana:
# - "Patrones de resiliencia prendidos en Orders": solo bulkhead queda en 1.
# - "Eventos de resiliencia": OnRateLimiterRejected en violeta, solo en
#   Products, con la cantidad de rechazos de cada intervalo de 5 segundos.
# - "Resultado de las llamadas a cada dependencia": "products ·
#   RateLimiterRejected" junto a unas pocas "products · HTTP 200", y
#   "users · HTTP 200" sin rechazos.
# - "Duración de las llamadas a cada dependencia, p95": Products en varios
#   segundos y Users en pocos milisegundos, sin cambios.

# ---------------------
# --- 04 Throttling ---
# ---------------------
# Al igual que en la demo de Retry, se consulta el detalle de las Orders del
# User 1. Pero ahora el problema no está en las dependencias sino en Orders: un
# pico de consultas podría saturarlo y degradarlo para todos sus clientes.
# Orders atiende como máximo 20 consultas de detalle a la vez. Las que exceden
# ese límite no esperan: reciben de inmediato un 503 con el encabezado
# Retry-After, que le indica al cliente en cuántos segundos conviene volver a
# intentar.
#
# El límite funciona como el compartimento de la demo de Bulkhead, pero en la
# dirección opuesta: el Bulkhead limita las llamadas que Orders hace a
# Products; el Throttling, las solicitudes que Orders recibe. Es un semáforo de
# 20 lugares, sin fila: si hay un lugar libre, la consulta lo toma y lo libera
# cuando termina la respuesta; si no, se rechaza antes de llegar al
# controlador. No hay fila porque esperar solo agregaría demora a un servicio
# que ya está saturado. La respuesta es 503 y no 429 porque el problema no es
# que un cliente pida demasiado, sino que el servicio está saturado. El límite
# es para todo el servicio, sin importar quién pide; el gateway aplica además
# un Throttling por cliente, que se ve en la demo de Rate Limiting.
#
# El siguiente script apaga todos los patrones, hace algunas rondas de
# consultas para que los servicios tengan abiertas sus conexiones, hace que
# Orders demore 5 segundos en cada consulta para simular que está cargado y
# lanza 40 consultas de detalle simultáneas. Después prende solo el Throttling y
# lanza otras 40. Mientras corre cada tanda, mide cuántas consultas atiende
# Orders a la vez, según las métricas de Orders. Tarda unos 25 segundos.

./demos/04-throttling.sh

# Resultado en consola: en cada tanda, una fila por consulta, en el orden en que
# se lanzaron, con el tiempo de respuesta, el código HTTP, el encabezado
# Retry-After, el nombre del cliente y el nombre del producto de cada Order, y
# un resumen.
# - Con el Throttling apagado, las 40 consultas se atienden con 200 en unos 5
#   segundos, y Orders llega a atender 40 a la vez: acepta todo lo que recibe.
#   Con 40 consultas Orders las atiende, pero con 1.000 se quedaría sin hilos,
#   conexiones o memoria, y se degradaría para todos sus clientes.
# - Con el Throttling prendido, Orders nunca atiende más de 20 a la vez. Las 20
#   primeras se atienden con 200 en unos 5 segundos, con todos los nombres, y
#   las 20 siguientes se rechazan de inmediato con 503, sin datos: como cada
#   consulta demora 5 segundos, las 20 primeras ocupan todos los lugares
#   mientras llegan las demás. Todas las rechazadas traen Retry-After: 2, y las
#   atendidas no lo traen.
#
# El Bulkhead está apagado en esta demo. Si estuviera prendido, algunas de las
# consultas atendidas dirían "no disponible [bulkhead lleno]" en uno o más
# productos: las 20 esperan los mismos 5 segundos y después llaman a Products
# todas a la vez, con 2 llamadas cada una, y el compartimento de Products
# admite 5 en curso y 5 en espera. El Throttling protege a Orders de lo que
# recibe, y el Bulkhead lo protege de lo que llama: cada patrón cubre un riesgo
# distinto, y en un sistema real actúan a la vez.

# Logs de Docker: una línea [THROTTLING] por cada consulta rechazada, solo en la
# segunda tanda.

docker compose logs orders-service | grep '\[THROTTLING\]'

# Grafana: entre las dos tandas el script espera 10 segundos, para que se
# distingan:
# - "Patrones de resiliencia prendidos en Orders": los cuatro en 0 durante la
#   primera tanda; en la segunda, throttling sube a 1.
# - "Throttling en Orders": "en curso" sube a 40 en la primera tanda y solo a 20
#   en la segunda. "rechazadas" aparece solo en la segunda, con 20. "aceptadas"
#   suma 40 en la primera, más las rondas para abrir conexiones, y 20 en la
#   segunda.
# - "Demora agregada a propósito": orders-service en 5 s durante cada tanda.

# Bajo carga: Orders demora 1 segundo y los usuarios virtuales suben de 0 a 40,
# se mantienen y bajan, en 60 segundos. Los clientes respetan Retry-After.

docker compose run --rm k6 run /scripts/throttling.js

# Resultado en la consola: todos los checks "status 200 o 503" pasan.
#
# Resultado en Grafana:
# - "Patrones de resiliencia prendidos en Orders": solo throttling queda en 1.
# - "Throttling en Orders": "en curso" sube y se queda en 20 aunque haya 40
#   usuarios virtuales; aparecen "rechazadas", la cantidad de cada intervalo de
#   5 segundos, mientras la carga supera el límite.
# - "Solicitudes por segundo, por código HTTP": aparecen los 503 en rojo.
# - "Demora agregada a propósito": orders-service en 1 s.

# ------------------------
# --- 05 Rate Limiting ---
# ------------------------
# En la demo de Throttling, Orders se protegía a sí mismo rechazando lo que no
# podía atender. El Rate Limiting es la otra cara: lo aplica el cliente, que
# regula el ritmo al que envía solicitudes para no superar el límite del
# servicio al que llama. Sin Rate Limiting, el cliente envía todo de golpe,
# recibe rechazos y tiene que reintentarlos: las solicitudes rechazadas no
# avanzan el trabajo, pero consumen capacidad del cliente, de la red y del
# servicio.
#
# En esta demo, el servicio es el API Gateway, que acepta como máximo 1 POST
# /orders/ por segundo por IP, con una ráfaga de hasta 5; lo que excede ese
# límite recibe 429 Too Many Requests sin llegar a Orders. nginx llama a esto
# rate limiting, pero en el catálogo de patrones de Azure es Throttling por
# cliente: lo aplica el servicio, no el cliente. El cliente es un proceso por
# lotes que necesita crear 15 Orders.
#
# El siguiente script crea las 15 Orders de dos formas. Primero sin Rate
# Limiting: las envía todas de golpe y reintenta las rechazadas cada 1 segundo.
# Después de esperar 10 segundos, con Rate Limiting: respeta el límite del
# gateway, con una ráfaga de 5 y después 1 por segundo. Tarda unos 30 segundos.

./demos/05-rate-limiting.sh

# Resultado en consola: para cada forma, una fila por solicitud, en el orden en
# que se enviaron, con el segundo en que se envió, contado desde el comienzo,
# el número de Order dentro del lote, el número de intento y el código HTTP; y
# un resumen con cuántas solicitudes hicieron falta, cuántas se rechazaron con
# 429 y cuánto demoró.
#
# Sin Rate Limiting, del primer envío de 15 solo pasan unas 6: las 5 de la
# ráfaga y 1 más. Después, cada segundo se reenvían todas las pendientes y pasa
# una sola, porque el gateway admite 1 por segundo: la Order 15 se reintenta
# unas 9 veces. En total hacen falta unas 55 solicitudes, de las que unas 40 se
# rechazan. Con Rate Limiting, las 5 primeras salen juntas y después 1 por
# segundo; todas son primer intento y ninguna se rechaza. Las dos formas
# demoran unos 10 segundos: el límite del gateway fija el ritmo máximo, y
# enviar de más no lo acelera.
# Logs de Docker: los 429 están en el access log de nginx; no llegan a
# orders-service.

docker compose logs api-gateway | grep '" 429 '

# Grafana:
# - "Solicitudes por segundo, por servicio y código HTTP": "orders-service ·
#   202" en cerca de 1 por segundo en las dos tandas, sin diferencias: Orders
#   recibe lo mismo con y sin Rate Limiting, porque los rechazos se quedan en el
#   gateway. Las series "users-service · 200" y "products-service · 200" son
#   los workers procesando las Orders.
# - Los 429 no se ven: Prometheus no lee métricas del gateway, solo de los
#   servicios. Para verlos en Grafana está el escenario de k6, que registra sus
#   propias respuestas.

# Bajo carga: durante 30 segundos el cliente envía 5 POST por segundo, sin Rate
# Limiting; después de una pausa de 5 segundos, durante otros 30 envía 1 por
# segundo, con Rate Limiting. Mientras tanto se consulta la lista de Orders, 5
# veces por segundo.

docker compose run --rm k6 run /scripts/rate-limiting.js

# Resultado en la consola: todos los checks pasan; en la fase sin Rate Limiting
# los POST responden 202 o 429, y en la fase con Rate Limiting, solo 202.
#
# Resultado en Grafana:
# - "Solicitudes por segundo, por código HTTP": en la primera fase, unos 4 por
#   segundo en naranja -429-; en verde, los 200 de la lista de Orders y 1 por
#   segundo de 202 de los POST aceptados. En la segunda fase, sin naranja.
# - "Latencia p95 vista por k6, por endpoint": "list orders" se mantiene en
#   unos 10 ms en las dos fases.
# - "Solicitudes por segundo, por servicio y código HTTP": la serie
#   "orders-service · 202" se mantiene en 1 por segundo en las dos fases: los
#   POST rechazados nunca llegan a orders-service.

# -------------------------------------
# --- 06 Health Endpoint Monitoring ---
# -------------------------------------
# Cada servicio expone /health, que verifica sus propias dependencias y devuelve
# el resultado de cada chequeo: 200 si está sano y 503 si no. Users chequea su
# base PostgreSQL; Products, su base MongoDB; y Orders, su base MySQL y RabbitMQ
# -si RabbitMQ no está, Orders queda Degraded y responde 200, porque sigue
# aceptando Orders: ver Transactional Outbox-. Orders no chequea a Users ni a
# Products: como se vio en la demo de Retry, si una de esas dependencias falla,
# Orders sigue funcionando degradado y no debe figurar como caído. Docker
# consulta /health cada 5 segundos para saber si cada contenedor está sano. El
# gateway publica el /health de cada servicio:

curl -s http://localhost/health/products | jq
curl -s http://localhost/health/orders | jq
curl -s http://localhost/health/users | jq

# El siguiente script detiene la base de Products, espera a que Docker marque el
# contenedor como unhealthy y la vuelve a levantar. Tarda cerca de un minuto.
# Conviene tener corriendo en otra terminal:
#
#     ./demos/monitor-health.sh

./demos/06-health.sh

# Resultado en la consola: al detener la base, /health/products pasa a 503
# Unhealthy con el detalle del chequeo que falló; /health/orders sigue Healthy
# porque Orders no depende de esa base. A los 15 segundos, Docker muestra
# products-service como unhealthy; al levantar la base, todo vuelve a healthy.
#
# Logs de Docker: los errores de conexión a MongoDB de products-service.

docker compose logs products-service --since 2m

# Grafana:
# - "Salud de los servicios": products-service en rojo, Unhealthy, mientras la
#   base de Products está detenida, y otra vez en verde al levantarla. Los demás
#   servicios siguen en verde: ninguno depende de esa base. Es lo mismo que
#   muestra ./demos/monitor-health.sh, pero a lo largo del tiempo.

# ------------------------------
# --- 07 Competing Consumers ---
# ------------------------------
# Al crear una Order con POST /orders/, Orders la guarda como pendiente y
# publica el evento order.created en RabbitMQ, a través del outbox -ver
# Transactional Outbox-. El evento llega a la cola orders.process. Tres
# réplicas de orders-worker consumen la misma cola, y RabbitMQ entrega cada
# mensaje a una sola. Cada réplica procesa una Order por vez: le pide a Users y
# a Products sus datos -como Orders en la demo de Retry-, la confirma o la
# rechaza, y recién entonces le confirma el mensaje a RabbitMQ -ack-. Si una
# réplica se cae antes, RabbitMQ entrega el mensaje a otra.
#
# Ver las tres réplicas de orders-worker y la cola orders.process: en la
# columna consumers, la cola tiene 3, una por réplica, y en messages no tiene
# mensajes esperando. La cola orders.details-view es la del proyector de la
# vista -ver CQRS- y no participa en esta demo.

docker compose ps -a --format 'table {{.Name}}\t{{.Status}}' orders-worker
docker compose exec rabbitmq rabbitmqctl list_queues -q name messages consumers | column -t

# Detener las tres réplicas. La cola orders.process se queda sin consumidores.

docker compose stop orders-worker
docker compose exec rabbitmq rabbitmqctl list_queues -q name messages consumers | column -t

# Crear una Order y guardar su id en una variable, para usarlo en los comandos
# siguientes. Orders la acepta igual -202-: la guarda como Pending y publica el
# evento order.created, sin esperar a que nadie la procese.

id=$(curl -s -X POST http://localhost/orders/ \
  -H "Content-Type: application/json" \
  -d '{"userId": 2, "productId": "60f7c2b5e1d3c2a1b8e4d125", "quantity": 1}' | jq .id)
echo "$id"

# Esperar unos segundos y consultar la Order: sigue Pending, porque no hay
# ningún worker. El mensaje espera en la cola: orders.process tiene 1 en
# messages y 0 en consumers.

curl -s http://localhost/orders/$id | table
docker compose exec rabbitmq rabbitmqctl list_queues -q name messages consumers | column -t

# Levantar una sola réplica y guardar su nombre en una variable. Al conectarse,
# RabbitMQ le entrega el mensaje que estaba esperando.

worker=$(docker compose ps -a --format '{{.Name}}' orders-worker | head -1)
docker start $worker

# Esperar unos segundos -lo que tarda en arrancar más lo que demora en procesar-
# y consultar la Order: ya está Confirmed. La cola quedó vacía y con 1
# consumidor.

curl -s http://localhost/orders/$id | table
docker compose exec rabbitmq rabbitmqctl list_queues -q name messages consumers | column -t

# En los logs de la réplica: se conectó a la cola, procesó la Order y la
# confirmó. Ningún mensaje se perdió mientras no había workers.

docker logs --since 1m $worker 2>&1 | grep '\[COMPETING CONSUMERS\]'

# Crear 6 Orders de golpe con una sola réplica. Se crean directamente en
# orders-service, en el puerto 8000, sin pasar por el gateway, para no chocar
# con su límite de POST /orders/ -ver Throttling-.

for i in $(seq 6); do
  curl -s -X POST http://localhost:8000/orders/ \
    -H "Content-Type: application/json" \
    -d '{"userId": 2, "productId": "60f7c2b5e1d3c2a1b8e4d125", "quantity": 1}' | jq -c
done

# Consultar la cola varias veces seguidas: los mensajes bajan de a uno cada 2
# segundos, porque una sola réplica procesa una Order por vez. Las 6 tardan
# unos 12 segundos.

docker compose exec rabbitmq rabbitmqctl list_queues -q name messages consumers | column -t

# En los logs, todas las Orders las procesó la misma réplica, una detrás de
# otra:

docker compose logs --since 30s orders-worker | grep '\[COMPETING CONSUMERS\]'

# Levantar las otras dos réplicas -docker compose start levanta las que estén
# detenidas, después de comprobar que los servicios de los que dependen están
# sanos- y ver que la cola vuelve a tener 3 consumidores.

docker compose start orders-worker
docker compose exec rabbitmq rabbitmqctl list_queues -q name messages consumers | column -t

# Esperar unos segundos a que arranquen y crear otras 6 Orders de golpe:

for i in $(seq 6); do
  curl -s -X POST http://localhost:8000/orders/ \
    -H "Content-Type: application/json" \
    -d '{"userId": 2, "productId": "60f7c2b5e1d3c2a1b8e4d125", "quantity": 1}' | jq -c
done

# Ahora las tres réplicas compiten por los mensajes de la misma cola: cada una
# toma una Order, y RabbitMQ le entrega la siguiente recién cuando confirma la
# anterior. En los logs, las Orders se reparten entre orders-worker-1, -2 y -3,
# unas 2 cada una, y las 6 se procesan en unos 4 segundos en lugar de 12. Los
# logs se muestran agrupados por réplica, y si pasaron menos de 30 segundos
# desde la tanda anterior, orders-worker-1 también muestra sus últimas Orders:
# hay que fijarse en los números de Order.

docker compose logs --since 30s orders-worker | grep '\[COMPETING CONSUMERS\]'

# El siguiente script crea 9 Orders y muestra qué réplica procesó cada una.
# Después crea 9 más, detiene una réplica mientras procesa y al final la vuelve
# a levantar. Tarda unos 30 segundos. La cola y sus consumidores se ven en la
# consola de RabbitMQ, http://localhost:15672, con usuario y contraseña guest.

./demos/07-competing-consumers.sh

# Resultado en la consola: cada réplica demora 2 segundos en procesar una Order.
# Las primeras 9 se procesan en unos 6 segundos, y cada réplica toma unas 3; una
# sola réplica habría demorado unos 18 segundos. En la segunda tanda, las 2
# réplicas restantes procesan todo, incluida la Order que estaba procesando la
# réplica detenida: como no había confirmado ese mensaje, RabbitMQ se lo entregó
# a otra réplica.
#
# Logs de Docker: qué réplica tomó cada Order.

docker compose logs orders-worker | grep '\[COMPETING CONSUMERS\]'

# Bajo carga: crea 60 Orders de golpe, sin pasar por el gateway.

docker compose run --rm k6 run /scripts/competing-consumers.js

# Para ver la tolerancia a fallas, durante la prueba se puede detener una réplica
# y después volver a levantarla:

docker stop $(docker compose ps -q orders-worker | head -1)

docker compose up -d orders-worker

# Resultado en Grafana:
# - "Cola orders.process": "esperando" salta a unas 50 y baja de forma pareja
#   en unos 40 s; "en proceso" queda en 3, una por réplica; "consumidores" baja
#   a 2 si se detiene una réplica.
# - "Orders procesadas por segundo, por réplica": tres franjas de igual
#   altura, unas 0,5 por segundo cada una; si se detiene una réplica, su franja
#   desaparece y la cola tarda más en vaciarse.

# -------------------------
# --- 08 Event Sourcing ---
# -------------------------
# Cada cambio de una Order se guarda como un evento inmutable en la tabla
# order_events: OrderCreated al crearla, y OrderConfirmed u OrderRejected cuando
# un worker la procesa, como en la demo de Competing Consumers. La tabla orders
# es solo una proyección: el estado actual, calculado a partir de los eventos.
#
# Crear una Order y guardar su id en una variable, para usarlo en los comandos
# siguientes. Orders responde 202 y la Order queda Pending: todavía no la
# procesó ningún worker.

id=$(curl -s -X POST http://localhost/orders/ \
  -H "Content-Type: application/json" \
  -d '{"userId": 2, "productId": "60f7c2b5e1d3c2a1b8e4d124", "quantity": 3}' | jq .id)
echo "$id"

# Esperar unos 3 segundos a que un worker la procese y consultar la Order.
# Debería estar Confirmed:

curl -s http://localhost/orders/$id | table

# Ver los eventos de la Order directamente en la tabla order_events. Hay dos:
# OrderCreated, que guardó Orders al crearla, y OrderConfirmed, que guardó el
# worker al procesarla. Los eventos nunca se modifican ni se borran: cada
# cambio agrega uno nuevo.

docker compose exec orders-db mysql -u ordersusr -pPa55w0rd ordersdb \
  -e "SELECT id, order_id, type, data, occurred_at FROM order_events WHERE order_id = $id"

# Ver la Order en la tabla orders. Tiene solo el estado actual, Confirmed: no
# dice que antes estuvo Pending ni cuándo cambió.

docker compose exec orders-db mysql -u ordersusr -pPa55w0rd ordersdb \
  -e "SELECT * FROM orders WHERE id = $id"

# Pedirle a Orders los eventos de la Order y el estado que resulta de
# reproducirlos, uno detrás de otro: OrderCreated la crea Pending, y
# OrderConfirmed la pasa a Confirmed. El estado reproducido coincide con el de
# la tabla orders. La respuesta tiene las dos partes: se muestra cada una como
# tabla por separado.

curl -s http://localhost/orders/$id/events | jq .events | table
curl -s http://localhost/orders/$id/events | jq .replayed_state | table

# Simular que se pierde la proyección: borrar todas las filas de la tabla
# orders directamente en MySQL.

docker compose exec orders-db mysql -u ordersusr -pPa55w0rd ordersdb \
  -e "DELETE FROM orders"

# Ahora Orders no tiene ninguna Order: la lista viene vacía y la Order creada
# antes no existe -404-.

curl -s http://localhost/orders/ | jq
curl -s -o /dev/null -w '%{http_code}\n' http://localhost/orders/$id

# Pero los eventos siguen ahí, y alcanzan para saber cuál era el estado de la
# Order:

curl -s http://localhost/orders/$id/events | jq .replayed_state | table

# Reconstruir la proyección: Orders reproduce todos los eventos de order_events
# y vuelve a llenar la tabla orders. La respuesta dice cuántos eventos leyó y
# cuántas Orders reconstruyó.

curl -s -X POST http://localhost/orders/projections/rebuild | table

# Las Orders volvieron, cada una con su estado: los eventos son la fuente de
# verdad, y la tabla orders se puede volver a calcular a partir de ellos. La
# cantidad de Orders coincide con la que informó la reconstrucción:

curl -s http://localhost/orders/ | jq length
curl -s http://localhost/orders/$id | table

# El siguiente script hace lo mismo: crea una Order, muestra sus eventos, borra
# la tabla orders directamente en MySQL y la reconstruye a partir de los
# eventos.

./demos/08-event-sourcing.sh

# Resultado en la consola: los eventos OrderCreated y OrderConfirmed y, debajo,
# el estado que resulta de reproducirlos. Después del borrado, GET /orders/
# devuelve una lista vacía. La reconstrucción informa cuántos eventos leyó y
# cuántas Orders reconstruyó, y la Order vuelve con su estado: los eventos son
# la fuente de verdad.
#
# Para ver la tabla de eventos directamente en la base:

docker compose exec orders-db mysql -u ordersusr -pPa55w0rd ordersdb \
  -e "SELECT id, order_id, type, occurred_at FROM order_events ORDER BY id DESC LIMIT 10"

# Resulado en Grafana: no hay un panel propio; en "Orders procesadas por
# segundo, por réplica" se ve la Order confirmada por una de las réplicas.

# -------------------------------
# --- 09 Transactional Outbox ---
# -------------------------------
# POST /orders/ no publica en RabbitMQ: guarda la Order, su evento OrderCreated
# y el mensaje order.created en la tabla outbox_messages, en la misma
# transacción. El relay del outbox, que corre en orders-service, publica cada
# segundo los mensajes pendientes y los marca como publicados. El worker hace lo
# mismo con order.confirmed y order.rejected. Si RabbitMQ no está, los mensajes
# esperan en la base: no se pierde ninguno, y Orders sigue aceptando Orders.
#
# El siguiente script detiene RabbitMQ, crea 5 Orders, muestra los mensajes
# pendientes y vuelve a levantar RabbitMQ. Tarda unos 30 segundos.

./demos/09-transactional-outbox.sh

# Resultado: las 5 Orders responden 202 aunque RabbitMQ no esté; antes del
# outbox, Orders respondía 503 y la Order quedaba Pending para siempre.
# /health/orders responde Degraded, no Unhealthy. Los 5 mensajes quedan
# pendientes en outbox_messages; al levantar RabbitMQ, el relay los publica, los
# workers confirman las Orders y no queda ninguno pendiente.
# Logs de Docker: "RabbitMQ no está disponible", una línea por mensaje publicado
# y "RabbitMQ volvió".

docker compose logs orders-service --since 2m | grep '\[OUTBOX\]'

# Para ver el outbox directamente en la base:
docker compose exec orders-db mysql -u ordersusr -pPa55w0rd ordersdb \
  -e "SELECT id, routing_key, created_at, published_at FROM outbox_messages ORDER BY id DESC LIMIT 10"
# Grafana:
# - "Outbox de Orders": "pendientes" sube a 5 durante los 15 segundos en que
#   RabbitMQ está detenido y vuelve a 0 cuando se levanta; en ese momento
#   aparece un pico en "publicados por segundo".
# - "Cola orders.process" y "Cola orders.details-view": las líneas se cortan
#   mientras RabbitMQ está detenido, porque Prometheus no puede leer sus
#   métricas.
# - "Salud de los servicios": mientras RabbitMQ está detenido, orders-service en
#   naranja, Degraded, porque sigue aceptando Orders gracias al outbox; y
#   orders-worker y orders-projector en rojo, Unhealthy, porque sin RabbitMQ no
#   pueden consumir.

# ---------------------------------------------------------------------------
# Patrones de rendimiento
# ---------------------------------------------------------------------------
# Los siguientes patrones agregan a la aplicación un exchange de eventos en
# RabbitMQ, andis.events; una caché de Products en Redis; y una vista
# materializada del detalle de las Orders, que mantiene orders-projector.

# ----------------------
# --- 10 Cache-Aside ---
# ----------------------
# Products busca primero en Redis. Si no está -miss-, lee MongoDB y lo guarda en
# Redis por 60 segundos; la próxima lectura sale de Redis -hit-. Al cambiar un
# Product, borra su clave de Redis. Para que la diferencia se note, se puede
# simular una base más lenta y apagar la caché, sin reiniciar:

curl -s -X PUT http://localhost/products/cache \
  -H "Content-Type: application/json" -d '{"enabled": true, "dbDelayMs": 200}' | jq
curl -s -X DELETE http://localhost/products/cache | jq

# El siguiente script simula una base que demora 200 ms, lee el mismo Product
# varias veces, le cambia el nombre y detiene Redis.

./demos/10-cache-aside.sh

# Resultado: la primera lectura demora unos 200 ms -miss- y las siguientes, 2 o
# 3 ms -hit-. Después de cambiar el nombre, la lectura siguiente es un miss y
# trae el nombre nuevo. Con Redis detenido, Products sigue respondiendo, a la
# velocidad de MongoDB.
# Logs de Docker: una línea [CACHE-ASIDE] por lectura, con hit o miss.

docker compose logs products-service --since 2m | grep '\[CACHE-ASIDE\]'

# Bajo carga: 50 lecturas por segundo, 30 s con la caché apagada y 30 s prendida.
docker compose run --rm k6 run /scripts/cache-aside.js
# Consola: el threshold de la fase con caché, p(95)<50, aparece con ✓.
# Grafana:
# - "Lecturas de la caché de Products, por resultado": "disabled" en unas 50
#   por segundo en la primera fase; en la segunda, "hit" en unas 50 por segundo
#   y algún "miss" al empezar, uno por Product.
# - "Latencia p95 por servicio": products-service baja de más de 100 ms a unos
#   5 ms cuando se prende la caché.
# - "Latencia p95 vista por k6, por endpoint": "product sin caché" por encima de
#   100 ms; "product con caché" empieza alto, por los primeros miss, y baja a
#   unos 5 ms.
# El script de la demo hace pocas lecturas: en Grafana se ve solo bajo carga.

# ------------------------------------
# --- 11 Queue-Based Load Leveling ---
# ------------------------------------
# POST /orders/ solo guarda la Order y responde; el trabajo de verificar el User
# y el Product lo hacen los workers desde la cola, a su ritmo. La cola absorbe
# el pico: Users y Products reciben como máximo una llamada por réplica del
# worker, lleguen las Orders que lleguen.
#
# El siguiente script crea 30 Orders a la vez, directamente en orders-service:
# el Throttling por cliente del gateway rechazaría el pico antes de llegar a la
# cola. Tarda unos 25 segundos.

./demos/11-queue-based-load-leveling.sh

# Resultado: las 30 responden 202 en pocos milisegundos; la cola baja de a 3
# mensajes cada 2 segundos, uno por réplica, hasta vaciarse.

# Bajo carga: 10 POST por segundo durante 10 s.
docker compose run --rm k6 run /scripts/load-leveling.js
# Consola: el threshold de "create order", p(95)<200, aparece con ✓.
# Grafana:
# - "Cola orders.process": "esperando" sube a unos 80 durante el pico y baja de
#   forma pareja durante algo más de un minuto; "en proceso" queda en 3, uno
#   por réplica.
# - "Latencia p95 vista por k6, por endpoint": "create order" se mantiene por
#   debajo de 30 ms durante todo el pico.

# ---------------------------------------------
# --- 12 Competing Consumers: escalabilidad ---
# ---------------------------------------------
# El mismo patrón de la demo 07, como patrón de rendimiento: el throughput crece
# agregando réplicas de orders-worker, sin cambiar el código.
#
# El siguiente script procesa 30 Orders con 3 réplicas, escala a 6 y procesa
# otras 30. Al terminar vuelve a 3 réplicas. Tarda cerca de un minuto.

./demos/12-competing-consumers-scaling.sh

# Resultado: con 3 réplicas, unos 21 segundos; con 6, unos 12.
# Bajo carga, con 6 réplicas:
docker compose up -d --scale orders-worker=6
docker compose run --rm k6 run /scripts/load-leveling.js
docker compose up -d --scale orders-worker=3
# Grafana:
# - "Cola orders.process": "consumidores" sube a 6 y "en proceso" a 6; la cola
#   se vacía en unos 40 segundos, cerca de la mitad que con 3 réplicas.
# - "Orders procesadas por segundo, por réplica": 6 franjas, una por réplica,
#   cada una identificada por el id de su contenedor.

# -------------------------------
# --- 13 Publisher/Subscriber ---
# -------------------------------
# Orders, Users y Products publican eventos en el exchange andis.events. Cada
# suscriptor tiene su propia cola y la enlaza con las claves que le interesan:
# orders.process, del worker, recibe order.created; orders.details-view, del
# proyector, recibe order.*, user.updated y product.updated. Los enlaces se ven
# en la consola de RabbitMQ, http://localhost:15672, en Exchanges > andis.events.
#
# El siguiente script muestra los enlaces, crea una Order y cambia el nombre de
# un Product y de un User, mostrando qué suscriptor recibe cada evento.

./demos/13-publisher-subscriber.sh

# Resultado: order.created llega al worker y al proyector; product.updated y
# user.updated, solo al proyector, que actualiza los nombres en la vista.
# Logs de Docker:

docker compose logs orders-projector --since 2m | grep '\[PUB/SUB\]'
docker compose logs users-service products-service --since 2m | grep '\[PUB/SUB\]'

# Grafana: no hay un panel propio. Son pocos eventos y se procesan enseguida:
# las colas de "Cola orders.process" y "Cola orders.details-view" no llegan a
# acumular mensajes. Los enlaces se ven en la consola de RabbitMQ.

# -------------------------------------
# --- 14 Asynchronous Request-Reply ---
# -------------------------------------
# POST /orders/ responde 202 Accepted con Location: /orders/{id}/status y
# Retry-After: 2. El estado responde 200 mientras la Order está Pending, y 303
# See Other a la Order cuando un worker la confirmó o la rechazó.
#
# El siguiente script crea una Order y consulta su estado respetando
# Retry-After hasta el 303.

./demos/14-asynchronous-request-reply.sh

# Resultado: el 202 con sus encabezados; dos o tres consultas con 200 Pending,
# una cada 2 segundos; el 303 con Location: /orders/{id}; y la Order confirmada.
# Grafana: no hay un panel propio.

# ---------------
# --- 15 CQRS ---
# ---------------
# Los comandos -crear y procesar Orders- escriben orders, order_events y
# outbox_messages. La consulta GET /orders/user/{userId}/details/view lee otra
# tabla, order_details, que ya tiene la forma de la respuesta: una consulta a
# MySQL y ninguna llamada a Users ni a Products. La consulta síncrona de las
# demos 01 a 04, GET /orders/user/{userId}/details, sigue disponible para
# comparar.
#
# El siguiente script hace la misma consulta por los dos lados, sin fallas y con
# Products demorando 300 ms, y después muestra la consistencia eventual.

./demos/15-cqrs.sh

# Resultado: sin fallas, la síncrona demora unos 100 ms y la vista, unos 3. Con
# Products lento, la síncrona pasa a casi 2 segundos y la vista no cambia. Justo
# después de crear una Order, la síncrona ya la tiene y la vista todavía no.

# Bajo carga, se corre load.js de las dos formas y se comparan en Grafana:
docker compose run --rm k6 run -e DETAILS=live /scripts/load.js
docker compose run --rm k6 run -e DETAILS=view /scripts/load.js
# Grafana, comparando la primera corrida con la segunda:
# - "Latencia p95 del detalle de Orders: síncrono contra vista": la línea
#   "orders/user/{userId}/details/view" queda por debajo de la de
#   "orders/user/{userId}/details". Sin fallas la diferencia es de pocos
#   milisegundos; con Products lento, como en el script, sería de segundos.
# - "Latencia p95 vista por k6, por endpoint": lo mismo visto por el cliente,
#   "details" en la primera corrida y "details view" en la segunda.
# - "Resultado de las llamadas a cada dependencia": en la segunda corrida todas
#   las series bajan a 0, porque con la vista Orders no llama a Users ni a
#   Products.

# ----------------------------
# --- 16 Materialized View ---
# ----------------------------
# order_details guarda el detalle de cada Order con el nombre del cliente y del
# producto ya copiados. La mantiene orders-projector a partir de los eventos:
# al recibir order.created busca los nombres una sola vez; con order.confirmed
# y order.rejected actualiza el estado; con user.updated y product.updated,
# los nombres.
#
# El siguiente script cambia el nombre de un Product, hace fallar a Products y
# detiene el proyector mientras se crea una Order.

./demos/16-materialized-view.sh

# Resultado: la vista refleja el nombre nuevo. Con Products fallando, la
# consulta síncrona responde "no disponible" y la vista, con los nombres. Con el
# proyector detenido, la Order se confirma pero no aparece en la vista, y sus
# eventos esperan en la cola; al levantarlo, la vista se pone al día.
# Logs de Docker:

docker compose logs orders-projector --since 2m | grep '\[MATERIALIZED VIEW\]'

# Para ver la vista directamente en la base:
docker compose exec orders-db mysql -u ordersusr -pPa55w0rd ordersdb \
  -e "SELECT * FROM order_details ORDER BY order_id DESC LIMIT 10"
# Grafana:
# - "Cola orders.details-view": durante los 15 segundos en que el proyector está
#   detenido, "consumidores" baja a 0 y "esperando" sube a 2, los eventos
#   order.created y order.confirmed de la Order nueva; al levantarlo, vuelven a
#   1 y a 0.
# - "Patrones de resiliencia prendidos en Orders": los cuatro bajan a 0 mientras
#   Products falla, y vuelven a 1 al terminar la demo.
# - "Salud de los servicios": orders-projector en gris, no responde, durante los
#   15 segundos en que está detenido.

# ---------------------------------------------------------------------------
# Prueba de carga base, para las demos de rendimiento
# ---------------------------------------------------------------------------
# Lecturas mezcladas -detalle de Orders, Products y Users- a una tasa que sube
# hasta RATE solicitudes por segundo, se mantiene durante DURATION y baja.
docker compose run --rm k6 run -e RATE=50 -e DURATION=2m /scripts/load.js
# Consola: los thresholds p(95)<500 y rate<0.01 aparecen con ✓ si se cumple el
# objetivo de rendimiento; si no, k6 los marca con ✗ y termina con error.
# Grafana: "Solicitudes por segundo, por servicio y código HTTP" y "Latencia
# p95 por servicio" muestran el throughput y la latencia de cada servicio; sirve
# como línea base para comparar antes y después de cada patrón de rendimiento.

# Para probar los endpoints sin pasar por el API Gateway, agrega los puertos
# donde están escuchando los servicios, por ejemplo:
# - http://localhost:8000/orders/
# - http://localhost:8001/products/
# - http://localhost:8002/users/UserService.svc?wsdl

# Tear down

docker compose --profile observability down -v

docker rmi api-gateway:latest orders-service:latest users-service:latest products-service:latest
docker rmi mysql:26 mongo:9 postgres:18 rabbitmq:4.4-management redis:8 nginx:1.25-alpine
docker rmi prom/prometheus:v3.15.1 grafana/grafana:13.2.5 grafana/k6:2.3.0
docker image prune -f
docker volume prune -f
docker builder prune -f

rm -rf ./OrdersService/mysqldata
rm -rf ./ProductsService/mongodbdata
rm -rf ./UsersService/pgdata


