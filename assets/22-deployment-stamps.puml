@startuml
!include PlantUML.style
rectangle "Cliente" as C
rectangle "Componentes globales" as G {
  rectangle "API Gateway\nelige la copia por X-Region" as GW
  rectangle "Keycloak" as K
  rectangle "Consul" as CS
}
rectangle "stamp-a\nX-Region: uy, u otra" as A {
  rectangle "Users, Products, Orders\nworkers y proyector" as SA
  rectangle "PostgreSQL, MongoDB, MySQL" as DA
  rectangle "RabbitMQ, Redis, Azurite\npuerto 10000" as IA
}
rectangle "stamp-b\nX-Region: br" as B {
  rectangle "Users, Products, Orders\nworkers y proyector" as SB
  rectangle "PostgreSQL, MongoDB, MySQL" as DB
  rectangle "RabbitMQ, Redis, Azurite\npuerto 10001" as IB
}
C --> GW
GW --> SA
GW --> SB
SA --> DA
SA --> IA
SB --> DB
SB --> IB
SA ..> CS : configuración
SB ..> CS : configuración
@enduml
