@startuml
!include PlantUML.style
rectangle "Orders\nOutboxRelay" as O
rectangle "Users\nUserService.UpdateUser" as U
rectangle "Products\nProductsController.UpdateProduct" as P
hexagon "Exchange de eventos, tipo topic\nandis.events" as X
queue "orders.process" as Q1
queue "orders.details-view" as Q2
rectangle "Procesa la Order\norders-worker" as W
rectangle "Mantiene la vista\norders-projector" as V

O --> X : order.created\norder.confirmed\norder.rejected
U --> X : user.updated
P --> X : product.updated
X --> Q1 : order.created
X --> Q2 : order.*\nuser.updated\nproduct.updated
Q1 --> W
Q2 --> V
@enduml
