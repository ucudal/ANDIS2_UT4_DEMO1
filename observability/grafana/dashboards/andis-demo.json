          },
          "expr": "sum(rate(aspnetcore_rate_limiting_requests_total{job=\"orders-service\", aspnetcore_rate_limiting_result!=\"acquired\"}[$__rate_interval]))",
          "legendFormat": "rechazadas por segundo",
