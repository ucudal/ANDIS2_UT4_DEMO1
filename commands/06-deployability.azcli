# Parte 6: demos de las estrategias de despliegue, de la 27 a la 33
#
# Las demos de disponibilidad están en 02-availability.azcli, las de
# rendimiento, en 03-performance.azcli, las de seguridad, en 04-security.azcli y
# las de facilidad de modificación, en 05-modifiability.azcli.
#
# Las cuatro demos en este archivo ponen en producción la versión v2 de Users,
# que corre en users-service-v2 al lado de la versión v1, en users-service. Es
# la misma imagen con otra versión configurada, y comparte la base. Los clientes
# llegan por la entrada de despliegue del gateway, en el puerto 8091: a qué
# versión va cada solicitud lo define /etc/nginx/deployment-routes.conf, en el
# contenedor del gateway. Cada respuesta dice qué versión la atendió, en el
# encabezado X-Version.
#
# Las demos 31 a 33 son las 27 a 29 con Kubernetes: la demo de Kubernetes es
# siempre la de Docker Compose más 4. Corren en un clúster de kind, con una
# imagen por versión de Users, y los despliegues los hace Argo Rollouts. Están
# al final del archivo, y no necesitan Docker Compose.

# ---------------------------------------------------------------------------
# Levantar todos los servicios
# ---------------------------------------------------------------------------

# Estos comandos deben ejecutarse desde la raíz del repositorio. Usar el comando
# 'Azure CLI: Run Line in Terminal'.

# Inicia Docker si no está iniciado
docker desktop start

# Crear las carpetas que serán montadas como volúmenes para contener las bases
# de datos
mkdir -p src/UsersService/pgdata
mkdir -p src/ProductsService/mongodbdata
mkdir -p src/OrdersService/mysqldata

# Levantar todos los contenedores
docker compose build
docker compose up -d --wait

# ---------------------------------------------------------------------------
# Observabilidad -opcional, recomendada para las demos-
# ---------------------------------------------------------------------------

# Levantar también Prometheus y Grafana. Si la aplicación ya está levantada,
# solo agrega los dos contenedores nuevos.
docker compose --profile observability up -d --wait

# Abrir en el navegador el dashboard de Grafana. Los paneles de estas demos están
# en la fila "Facilidad de despliegue":
#
#    http://localhost:3000

# ---------------------------------------------------------------------------
# Variables
# ---------------------------------------------------------------------------

# Guardar en variables la solicitud SOAP GetUser del User 1, y del User 2
soap1='<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Body>
    <GetUser xmlns="http://ucu.edu.uy/andis/users">
      <id>1</id>
    </GetUser>
  </soap:Body>
</soap:Envelope>'
soap2='<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Body>
    <GetUser xmlns="http://ucu.edu.uy/andis/users">
      <id>2</id>
    </GetUser>
  </soap:Body>
</soap:Envelope>'

# ---------------------------------------------------------------------------
# Demo 27: Blue/Green Deployment
# ---------------------------------------------------------------------------
# La versión v2 se despliega al lado de la v1, se prueba sin que reciba tráfico
# y se conmuta de una vez. Volver atrás es conmutar de nuevo.

# Las dos versiones están vivas
docker compose ps users-service users-service-v2

# La entrada de despliegue manda todo a la versión v1
docker compose exec api-gateway cat /etc/nginx/deployment-routes.conf
curl -si -X POST http://localhost:8091/users/UserService.svc -d "$soap1" \
  -H 'Content-Type: text/xml; charset=utf-8' \
  -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/GetUser"'

# Probar la versión v2 directamente, desde adentro de la red, antes de exponerla.
# Trae un campo nuevo, DisplayName.
docker compose exec api-gateway curl -si -X POST http://users-service-v2:8000/users/UserService.svc -d "$soap1" \
  -H 'Content-Type: text/xml; charset=utf-8' \
  -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/GetUser"'

# Conmutar: todo el tráfico a la versión v2, y recargar nginx sin cortar el
# servicio
docker compose exec -T api-gateway sh -c 'cat > /etc/nginx/deployment-routes.conf && nginx -s reload' <<'EOF'
map $host $users_target {
    default users-service-v2:8000;
}
EOF

# Cuántas de 10 solicitudes atendió cada versión: todas la v2
for i in $(seq 10); do
  curl -s -o /dev/null -w '%header{x-version}\n' -X POST http://localhost:8091/users/UserService.svc -d "$soap1" \
    -H 'Content-Type: text/xml; charset=utf-8' \
    -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/GetUser"'
done | sort | uniq -c

# Vuelta atrás: la versión v1 sigue viva, así que volver es conmutar de nuevo
docker compose exec -T api-gateway sh -c 'cat > /etc/nginx/deployment-routes.conf && nginx -s reload' <<'EOF'
map $host $users_target {
    default users-service:8000;
}
EOF

# La demo completa, con una sonda que pide el User 1 cada 0.1 segundos mientras
# se conmuta: ninguna respuesta con error

./demos/27-blue-green.sh

# Bajo carga: lanza un escenario de k6 y hace los cambios mientras corre. Cada
# cambio queda marcado con una línea vertical en los paneles. Resultado en
# Grafana:
# - "Solicitudes por versión": el tráfico pasa de una versión a la otra de una
#   vez, en cada conmutación.
# - "Respuestas con error, por versión": la línea "sin errores", en 0.

./demos/load-deployment.sh bluegreen

# ---------------------------------------------------------------------------
# Demo 28: Rolling Upgrade
# ---------------------------------------------------------------------------
# Tres instancias de la versión v1 se reemplazan de a una por réplicas de la v2.
# Cada lote espera a que la instancia nueva esté sana antes de detener una vieja.
#
# Las instancias comparten el alias de red users-pool, y nginx reparte entre las
# IP que devuelve el DNS de Docker. users-service no entra en el grupo, porque
# lo usan las demás demos: las instancias de la versión v1 se crean a partir de
# su definición.

# Guardar en una variable la red de la aplicación
network=$(docker inspect -f '{{range $name, $_ := .NetworkSettings.Networks}}{{$name}}{{end}}' $(docker compose ps -q api-gateway))

# Levantar el servicio sin réplicas de la versión v2, para que el grupo empiece
# solo con la v1
docker compose up -d --no-deps --scale users-service-v2=0 users-service-v2

# Tres instancias de la versión v1, con el alias users-pool
for name in users-v1-1 users-v1-2 users-v1-3; do
  docker compose run -d --no-deps --name $name users-service
  docker network disconnect $network $name
  docker network connect --alias users-pool $network $name
done

# Esperar a que estén sanas
docker ps --filter name=users-v1 --format '{{.Names}}: {{.Status}}'

# Modificar la entrada de despliegue en el contenedor del gateway, para que el
# tráfico en el puerto 8091 vaya hacia users-pool en lugar de users-service.
docker compose exec -T api-gateway sh -c 'cat > /etc/nginx/deployment-routes.conf && nginx -s reload' <<'EOF'
map $host $users_target {
    default users-pool:8000;
}
EOF

# Examinar as IP del grupo
docker compose exec api-gateway getent ahostsv4 users-pool

# Hacer 12 solicitudes a Users en la entrada de despliegue y ver cuantas de esas
# solicitudes atendió cada versión: todas la v1
for i in $(seq 12); do
  curl -s -o /dev/null -w '%header{x-version}\n' -X POST http://localhost:8091/users/UserService.svc -d "$soap1" \
    -H 'Content-Type: text/xml; charset=utf-8' \
    -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/GetUser"'
done | sort | uniq -c

# Paso 1: una réplica de la versión v2; --wait espera a que esté sana. Recién
# entonces, se detiene una instancia de la v1. Docker Compose avisa "Found
# orphan containers": son las instancias de la versión v1, que no están en
# docker-compose.yaml. No hay que hacer nada.
docker compose up -d --no-deps --scale users-service-v2=1 --wait users-service-v2
docker stop users-v1-1

# Repetir las 12 solicitudes: responden las dos versiones
for i in $(seq 12); do
  curl -s -o /dev/null -w '%header{x-version}\n' -X POST http://localhost:8091/users/UserService.svc -d "$soap1" \
    -H 'Content-Type: text/xml; charset=utf-8' \
    -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/GetUser"'
done | sort | uniq -c

# Pasos 2 y 3
docker compose up -d --no-deps --scale users-service-v2=2 --wait users-service-v2
docker stop users-v1-2
docker compose up -d --no-deps --scale users-service-v2=3 --wait users-service-v2
docker stop users-v1-3

# Repetir las 12 solicitudes: todas las atiende v2
for i in $(seq 12); do
  curl -s -o /dev/null -w '%header{x-version}\n' -X POST http://localhost:8091/users/UserService.svc -d "$soap1" \
    -H 'Content-Type: text/xml; charset=utf-8' \
    -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/GetUser"'
done | sort | uniq -c

# Dejar todo como estaba: sin las instancias de la versión v1, con una réplica
# de la v2 y la entrada de despliegue hacia users-service
docker rm -f users-v1-1 users-v1-2 users-v1-3
docker compose up -d --no-deps --scale users-service-v2=1 --wait users-service-v2
docker compose exec -T api-gateway sh -c 'cat > /etc/nginx/deployment-routes.conf && nginx -s reload' <<'EOF'
map $host $users_target {
    default users-service:8000;
}
EOF

# La demo completa, con una sonda que pide el User 1 cada 0.1 segundos durante
# todo el reemplazo: ninguna respuesta con error

./demos/28-rolling-upgrade.sh

# Bajo carga. Resultado en Grafana:
# - "Solicitudes por versión": la versión v2 sube en escalones, un tercio por
#   lote, mientras la v1 baja.
# - "Respuestas con error, por versión": la línea "sin errores", en 0.

./demos/load-deployment.sh rolling

# ---------------------------------------------------------------------------
# Demo 29: Canary Testing
# ---------------------------------------------------------------------------
# Una fracción de las solicitudes va a la versión v2. Si sus métricas son
# buenas, la fracción crece; si no, vuelve a cero. split_clients de nginx elige
# el destino de cada solicitud con un hash de $request_id.

# Configurar el gateway para que el 10% del tráfico vaya a la versión v2
docker compose exec -T api-gateway sh -c 'cat > /etc/nginx/deployment-routes.conf && nginx -s reload' <<'EOF'
split_clients "${request_id}" $users_target {
    10% users-service-v2:8000;
    *   users-service:8000;
}
EOF

# Ver cuántas de 50 solicitudes atendió cada versión
for i in $(seq 50); do
  curl -s -o /dev/null -w '%header{x-version}\n' -X POST http://localhost:8091/users/UserService.svc -d "$soap1" \
    -H 'Content-Type: text/xml; charset=utf-8' \
    -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/GetUser"'
done | sort | uniq -c

# Levantar una versión v2 con un error: se le inyectan fallas solo a ella, desde
# adentro de la red. Por el puerto 80, /users/chaos llegaría a la versión v1.
docker compose exec api-gateway curl -s -X PUT http://users-service-v2:8000/users/chaos \
  -H 'Content-Type: application/json' -d '{"failureRate": 1, "delayMs": 0}'

# Las mismas 50 solicitudes, con el código HTTP: fallan solo las de la versión
# v2, cerca del 10%
for i in $(seq 50); do
  curl -s -o /dev/null -w '%{http_code} %header{x-version}\n' -X POST http://localhost:8091/users/UserService.svc -d "$soap1" \
    -H 'Content-Type: text/xml; charset=utf-8' \
    -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/GetUser"'
done | sort | uniq -c

# Esta situación de fallas en la versión v2 se puede detectar automáticamente en
# una aplicación de monitoreo y en ese caso también automáticamente hacer vuelta
# atrás, y volver todo a la versión v1
docker compose exec -T api-gateway sh -c 'cat > /etc/nginx/deployment-routes.conf && nginx -s reload' <<'EOF'
map $host $users_target {
    default users-service:8000;
}
EOF
docker compose exec api-gateway curl -s -X DELETE http://users-service-v2:8000/users/chaos

# Una vez completada la vuelta atrás, las mismas 50 solicitudes no fallan y
# todas las responde v1
for i in $(seq 50); do
  curl -s -o /dev/null -w '%{http_code} %header{x-version}\n' -X POST http://localhost:8091/users/UserService.svc -d "$soap1" \
    -H 'Content-Type: text/xml; charset=utf-8' \
    -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/GetUser"'
done | sort | uniq -c

# La demo completa: 10%, 50% y 100%, y después el canario que falla

./demos/29-canary.sh

# Bajo carga. Resultado en Grafana:
# - "Solicitudes por versión": la versión v2 sigue al porcentaje del canario.
# - "Respuestas con error, por versión": solo la versión v2, mientras falla,
#   hasta la vuelta atrás.

./demos/load-deployment.sh canary

# ---------------------------------------------------------------------------
# Demo 30: A/B Testing
# ---------------------------------------------------------------------------
# La versión v2 trae un experimento: cada User ve su nombre en una de dos
# variantes. La A muestra el nombre, y la B el nombre y el email. Qué variante
# ve cada User no lo decide el código: lo decide Unleash, en el flag
# 'users-display-name', y Users se lo pregunta con OpenFeature. El flag tiene
# dos estrategias, que se evalúan en orden:
# - Por segmento: si la solicitud trae X-Segment: beta, la variante B.
# - Por porcentaje: si no, un reparto entre A y B según un hash del id del
#   User, que la mantiene fija para cada User, es decir, el mismo usuario tiene
#   siempre la misma variante.
# El reparto se cambia en Unleash, sin desplegar. El gateway no sabe nada del
# experimento.

# Levantar Unleash, del perfil feature-flags. Consola: http://localhost:4242,
# usuario admin, contraseña unleash4all
docker compose --profile feature-flags up -d --wait unleash

# Guardar en una variable la ruta de las estrategias del flag de Unleash en el
# entorno development, para simplificar los comandos de la demo
strategies=http://localhost:4242/api/admin/projects/default/features/users-display-name/environments/development/strategies

# Crear en Unleash el campo de contexto segment: tiene que conocerlo para usarlo
# en una restricción
curl -sS -X POST http://localhost:4242/api/admin/context \
  -H 'Authorization: *:*.andis-admin-token' \
  -H 'Content-Type: application/json' \
  -d '{"name": "segment", "stickiness": false}' | jq

# Crear en Unleash el flag, de tipo experimento. Si ya existe, porque ya se
# corrió demos/30-ab-testing.sh o estos mismos comandos, Unleash responde con un
# error, y se sigue igual
curl -sS -X POST http://localhost:4242/api/admin/projects/default/features \
  -H 'Authorization: *:*.andis-admin-token' \
  -H 'Content-Type: application/json' \
  -d '{"name": "users-display-name", "type": "experiment"}' | jq

# Borrar en Unleash las estrategias que ya tenga el flag, para no duplicarlas al
# crearlas de nuevo. Si el flag es nuevo, no hay ninguna
for old in $(curl -sS $strategies -H 'Authorization: *:*.andis-admin-token' | jq -r '.[].id'); do
  curl -sS -X DELETE $strategies/$old -H 'Authorization: *:*.andis-admin-token'
done

# La primera estrategia: con el segmento 'beta', siempre responde la variante B.
# Como el proveedor de Unleash para OpenFeature no devuelve el nombre de la
# variante sino su payload, cada variante lleva su nombre como payload. Por
# último, la variante se elige con un hash del id del User y del groupId: el
# mismo User cae siempre en la misma variante. Con 'users-experiment' como
# groupId, el User 1 cae en la B y el User 2 en la A.
curl -sS -X POST $strategies \
  -H 'Authorization: *:*.andis-admin-token' \
  -H 'Content-Type: application/json' \
  -d '{
  "name": "flexibleRollout", "title": "Segmento beta",
  "constraints": [{"contextName": "segment", "operator": "IN", "values": ["beta"]}],
  "parameters": {"rollout": "100", "stickiness": "userId", "groupId": "users-experiment"},
  "variants": [
    {"name": "B", "weight": 1000, "weightType": "variable", "stickiness": "userId", "payload": {"type": "string", "value": "B"}}]}' | jq

# La segunda estrategia: se aplica a las solicitudes sin el segmento 'beta', y
# reparte los Users la mitad en cada variante, con el mismo hash del id. Los
# pesos van de 0 a 1000: 500 es la mitad. La B tiene un peso fijo, y la A se
# queda con el resto hasta 1000.
curl -sS -X POST $strategies -H 'Authorization: *:*.andis-admin-token' -H 'Content-Type: application/json' -d '{
  "name": "flexibleRollout", "title": "Todos los Users", "constraints": [],
  "parameters": {"rollout": "100", "stickiness": "userId", "groupId": "users-experiment"},
  "variants": [
    {"name": "A", "weight": 500, "weightType": "variable", "stickiness": "userId", "payload": {"type": "string", "value": "A"}},
    {"name": "B", "weight": 500, "weightType": "fix", "stickiness": "userId", "payload": {"type": "string", "value": "B"}}]}' | jq

# Prender en Unleash el flag del experimento: Unleash lo apaga al borrar su
# última estrategia
curl -sS -X POST ${strategies%/strategies}/on -H 'Authorization: *:*.andis-admin-token'

# Desplegar la versión v2 con Blue/Green
docker compose exec -T api-gateway sh -c 'cat > /etc/nginx/deployment-routes.conf && nginx -s reload' <<'EOF'
map $host $users_target {
    default users-service-v2:8000;
}
EOF

# El User 1, que es 'alice', cae en la variante B: el encabezado X-Variant y el
# campo DisplayName
curl -si -X POST http://localhost:8091/users/UserService.svc -d "$soap1" \
  -H 'Content-Type: text/xml; charset=utf-8' \
  -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/GetUser"'

# El User 2, que es 'bob', cae en la A, y siempre en la A
curl -si -X POST http://localhost:8091/users/UserService.svc -d "$soap2" \
  -H 'Content-Type: text/xml; charset=utf-8' \
  -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/GetUser"'

# Con el segmento beta, bob recibe la B
curl -si -X POST http://localhost:8091/users/UserService.svc -d "$soap2" \
  -H 'Content-Type: text/xml; charset=utf-8' -H 'X-Segment: beta' \
  -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/GetUser"'

# Cambiar el reparto en Unleash, sin desplegar: todos los Users a la variante
# B. Se reemplaza la segunda estrategia, que se busca por su título y se guarda
# en la variable 'id'
id=$(curl -sS $strategies -H 'Authorization: *:*.andis-admin-token' | jq -r '.[] | select(.title == "Todos los Users") | .id')
curl -sS -X PUT $strategies/$id -H 'Authorization: *:*.andis-admin-token' -H 'Content-Type: application/json' -d '{
  "name": "flexibleRollout", "title": "Todos los Users", "constraints": [],
  "parameters": {"rollout": "100", "stickiness": "userId", "groupId": "users-experiment"},
  "variants": [
    {"name": "B", "weight": 1000, "weightType": "variable", "stickiness": "userId", "payload": {"type": "string", "value": "B"}}]}' | jq

# Users vuelve a leer el flag cada 2 segundos: unos segundos después, bob
# también recibe la B, sin reiniciar ni desplegar nada
curl -si -X POST http://localhost:8091/users/UserService.svc -d "$soap2" \
  -H 'Content-Type: text/xml; charset=utf-8' \
  -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/GetUser"'

# Detener Unleash: Users sigue respondiendo con la última configuración que
# leyó, y bob sigue en la B. Unleash no está en el camino de cada solicitud
docker compose stop unleash
curl -si -X POST http://localhost:8091/users/UserService.svc -d "$soap2" \
  -H 'Content-Type: text/xml; charset=utf-8' \
  -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/GetUser"'

# Volver a levantar Unleash, y el reparto a la mitad en cada variante
docker compose --profile feature-flags up -d --wait unleash
curl -sS -X PUT $strategies/$id -H 'Authorization: *:*.andis-admin-token' -H 'Content-Type: application/json' -d '{
  "name": "flexibleRollout", "title": "Todos los Users", "constraints": [],
  "parameters": {"rollout": "100", "stickiness": "userId", "groupId": "users-experiment"},
  "variants": [
    {"name": "A", "weight": 500, "weightType": "variable", "stickiness": "userId", "payload": {"type": "string", "value": "A"}},
    {"name": "B", "weight": 500, "weightType": "fix", "stickiness": "userId", "payload": {"type": "string", "value": "B"}}]}'

# Cuántas veces mostró cada variante la versión v2, según sus métricas
docker compose exec api-gateway curl -s http://users-service-v2:8000/metrics | grep '^users_experiment_total'

# Volver a la versión v1
docker compose exec -T api-gateway sh -c 'cat > /etc/nginx/deployment-routes.conf && nginx -s reload' <<'EOF'
map $host $users_target {
    default users-service:8000;
}
EOF

# La demo completa

./demos/30-ab-testing.sh

# Bajo carga: los dos Users consultan a la versión v2, y la mitad de las
# consultas de bob traen el segmento beta. Resultado en Grafana:
# - "Respuestas por variante": alice siempre en la B; bob en la A, salvo con el
#   segmento, en la B.

./demos/load-deployment.sh ab

# ---------------------------------------------------------------------------
# Demos 31 a 33: las mismas estrategias, con Kubernetes
# ---------------------------------------------------------------------------
# Necesitan kind, kubectl y el plugin de Argo Rollouts para kubectl:
#   brew install kind kubectl argoproj/tap/kubectl-argo-rollouts
#
# El clúster tiene su propia base de Users y no usa nada de Docker Compose. Los
# clientes llegan por el Gateway del clúster, en el puerto 8092, en lugar de la
# entrada de despliegue del 8091. Cada versión de Users es una imagen:
# users-service:v1, users-service:v2 y users-service:v3-bad, que falla en el
# 30% de las solicitudes desde que arranca.

# Crear el clúster, una sola vez: construye las tres imágenes, instala Gateway
# API, NGINX Gateway Fabric, Argo Rollouts y su plugin de Gateway API, y aplica
# k8s/base: la base de Users, el Gateway, Prometheus y el análisis de errores
./demos/k8s-up.sh

# Ver lo que quedó en el namespace andis
kubectl get pods,services,gateway -n andis

# ---------------------------------------------------------------------------
# Demo 31: Blue/Green con Argo Rollouts
# ---------------------------------------------------------------------------
# Es la demo 27, pero lo que allí se hacía a mano lo hace Argo Rollouts, con un
# comando por paso. Los clientes van al Service users-active; la versión nueva
# se prueba por users-preview, en http://preview.localhost:8092.

# Aplicar el Rollout users con la versión v1, sus dos Service y las rutas
kubectl apply -f k8s/blue-green
kubectl argo rollouts status users -n andis

# El Rollout: una versión, la v1, que es stable y active
kubectl argo rollouts get rollout users -n andis

# Responde la versión v1: el encabezado X-Version
curl -si -X POST http://localhost:8092/users/UserService.svc -d "$soap1" \
  -H 'Content-Type: text/xml; charset=utf-8' \
  -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/GetUser"'

# Desplegar la versión v2: Argo levanta sus pods al lado de los de la v1, y se
# detiene a esperar. La v2 queda como preview
kubectl argo rollouts set image users users=users-service:v2 -n andis
kubectl argo rollouts get rollout users -n andis

# Los clientes siguen en la versión v1...
curl -s -o /dev/null -w '%{http_code} versión %header{x-version}\n' \
  -X POST http://localhost:8092/users/UserService.svc -d "$soap1" \
  -H 'Content-Type: text/xml; charset=utf-8' \
  -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/GetUser"'

# ...y la versión v2 se prueba por users-preview. curl resuelve
# preview.localhost a la máquina local
curl -si -X POST http://preview.localhost:8092/users/UserService.svc -d "$soap1" \
  -H 'Content-Type: text/xml; charset=utf-8' \
  -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/GetUser"'

# Conmutar: Argo apunta users-active a los pods de la versión v2. Los de la v1
# siguen vivos un minuto, con la etiqueta delay
kubectl argo rollouts promote users -n andis
kubectl argo rollouts get rollout users -n andis

# Ahora responde la versión v2, en la misma dirección
curl -s -o /dev/null -w '%{http_code} versión %header{x-version}\n' \
  -X POST http://localhost:8092/users/UserService.svc -d "$soap1" \
  -H 'Content-Type: text/xml; charset=utf-8' \
  -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/GetUser"'

# Volver atrás: dentro de ese minuto, Argo vuelve a los pods de la versión v1
# enseguida, sin esperar a que arranquen
kubectl argo rollouts undo users -n andis
curl -s -o /dev/null -w '%{http_code} versión %header{x-version}\n' \
  -X POST http://localhost:8092/users/UserService.svc -d "$soap1" \
  -H 'Content-Type: text/xml; charset=utf-8' \
  -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/GetUser"'

# Borrar el Rollout, sus Service y las rutas
kubectl delete -f k8s/blue-green

# La demo completa, con una sonda que pide el User 1 cada 0.1 segundos durante
# la conmutación y la vuelta atrás: ninguna respuesta con error

./demos/31-argo-blue-green.sh

# Bajo carga. Necesita el perfil observability de Docker Compose. Resultado en
# Grafana: lo mismo que en la demo 27
./demos/load-deployment.sh k8s-bluegreen

# ---------------------------------------------------------------------------
# Demo 32: Rolling Upgrade con Kubernetes
# ---------------------------------------------------------------------------
# Es la demo 28, en dos partes. Primero con un Deployment de Kubernetes, que
# reemplaza los pods de a uno pero solo sabe si un pod está listo. Después con
# Argo Rollouts, que después de cada paso mide en Prometheus los errores de los
# pods nuevos, y vuelve atrás solo si fallan.

# Parte 1. Aplicar el Service, la ruta y el Deployment users, con 3 pods de la
# versión v1
kubectl apply -f k8s/rolling-upgrade/service.yaml -f k8s/rolling-upgrade/deployment.yaml
kubectl rollout status deployment/users -n andis
kubectl get pods -n andis -l app=users

# Desplegar la versión v2: Kubernetes levanta un pod nuevo, espera a que esté
# listo y recién entonces detiene uno viejo, tres veces
kubectl set image deployment/users users=users-service:v2 -n andis
kubectl rollout status deployment/users -n andis
kubectl get pods -n andis -l app=users

# Hacer 12 solicitudes: todas las atiende la versión v2
for i in $(seq 12); do
  curl -s -o /dev/null -w '%{http_code} versión %header{x-version}\n' \
    -X POST http://localhost:8092/users/UserService.svc -d "$soap1" \
    -H 'Content-Type: text/xml; charset=utf-8' \
    -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/GetUser"'
done | sort | uniq -c

# Desplegar la versión v3, con un error: responde /health, así que para
# Kubernetes sus pods están listos, y la despliega en los tres
kubectl set image deployment/users users=users-service:v3-bad -n andis
kubectl rollout status deployment/users -n andis

# Hacer 30 solicitudes: cerca del 30% responden 503, y siguen así hasta que
# alguien se da cuenta
for i in $(seq 30); do
  curl -s -o /dev/null -w '%{http_code} versión %header{x-version}\n' \
    -X POST http://localhost:8092/users/UserService.svc -d "$soap1" \
    -H 'Content-Type: text/xml; charset=utf-8' \
    -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/GetUser"'
done | sort | uniq -c

# Volver atrás, a mano, a la versión v2
kubectl rollout undo deployment/users -n andis
kubectl rollout status deployment/users -n andis

# Parte 2. Cambiar el Deployment por el Rollout users, con 3 pods de la versión
# v2. Los pasos y el análisis están en k8s/rolling-upgrade/rollout.yaml
kubectl delete deployment users -n andis
kubectl apply -f k8s/rolling-upgrade/rollout.yaml
kubectl argo rollouts status users -n andis

# El análisis necesita tráfico: pedir el User 1 cada 0.1 segundos, en segundo
# plano
while true; do
  curl -s -o /dev/null -X POST http://localhost:8092/users/UserService.svc -d "$soap1" \
    -H 'Content-Type: text/xml; charset=utf-8' \
    -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/GetUser"'
  sleep 0.1
done &

# Desplegar la versión v3 con el error, y mirar el Rollout en vivo: un pod
# nuevo y un AnalysisRun. En menos de un minuto el análisis falla, y Argo vuelve
# a la versión v2. Salir con Ctrl+C
kubectl argo rollouts set image users users=users-service:v3-bad -n andis
kubectl argo rollouts get rollout users -n andis --watch

# Lo que midió el análisis: la fracción de errores de los pods de la versión v3
kubectl get analysisrun -n andis \
  -o jsonpath='{range .items[*]}{.metadata.name}: {.status.phase} {.status.metricResults[0].measurements[*].value}{"\n"}{end}'

# Detener el tráfico en segundo plano, y borrar el Rollout, el Service y la ruta
kill %1
kubectl delete -f k8s/rolling-upgrade --ignore-not-found

# La demo completa

./demos/32-k8s-rolling-upgrade.sh

# Bajo carga, solo la parte del Deployment. Resultado en Grafana:
# - "Solicitudes por versión": la versión v2 reemplaza a la v1, y después la v3
#   a la v2, hasta el undo.
# - "Respuestas con error, por versión": la versión v3 responde 503 hasta que
#   se vuelve atrás.
./demos/load-deployment.sh k8s-rolling

# ---------------------------------------------------------------------------
# Demo 33: Canary con Argo Rollouts
# ---------------------------------------------------------------------------
# Es la demo 29, pero lo que allí se hacía a mano -cambiar el porcentaje, mirar
# los errores, decidir- lo hace Argo Rollouts. Cambia los pesos de la ruta users
# entre los Service users-stable y users-canary: 10%, análisis, 50%, análisis y
# 100%. Si un análisis falla, vuelve todo a la versión estable.

# Aplicar el Rollout users con la versión v1, sus dos Service y la ruta
kubectl apply -f k8s/canary
kubectl argo rollouts status users -n andis

# Los pesos de la ruta: todo a users-stable
kubectl get httproute users -n andis \
  -o jsonpath='{range .spec.rules[0].backendRefs[*]}{.name} {.weight}%{"\n"}{end}'

# El análisis necesita tráfico: pedir el User 1 cada 0.1 segundos, en segundo
# plano
while true; do
  curl -s -o /dev/null -X POST http://localhost:8092/users/UserService.svc -d "$soap1" \
    -H 'Content-Type: text/xml; charset=utf-8' \
    -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/GetUser"'
  sleep 0.1
done &

# Desplegar la versión v2 y mirar el Rollout en vivo: avanza sola del 10% al
# 100% en un minuto y medio, con un análisis exitoso en cada paso. Salir con
# Ctrl+C
kubectl argo rollouts set image users users=users-service:v2 -n andis
kubectl argo rollouts get rollout users -n andis --watch

# Mientras avanza, en otra terminal, los pesos de la ruta en cada paso
kubectl get httproute users -n andis \
  -o jsonpath='{range .spec.rules[0].backendRefs[*]}{.name} {.weight}%{"\n"}{end}'

# Desplegar la versión v3 con el error: con el 10%, el análisis falla, y Argo
# vuelve todo a la versión v2. Salir con Ctrl+C
kubectl argo rollouts set image users users=users-service:v3-bad -n andis
kubectl argo rollouts get rollout users -n andis --watch

# Lo que midió cada análisis: 0 con la versión v2, cerca de 0.3 con la v3
kubectl get analysisrun -n andis \
  -o jsonpath='{range .items[*]}{.metadata.name}: {.status.phase} {.status.metricResults[0].measurements[*].value}{"\n"}{end}'

# Detener el tráfico en segundo plano, y borrar el Rollout, sus Service y la
# ruta
kill %1
kubectl delete -f k8s/canary

# La demo completa

./demos/33-argo-canary.sh

# Bajo carga. Resultado en Grafana:
# - "Solicitudes por versión": la versión v2 sigue a los pesos del 10% y el
#   50%, hasta el 100%.
# - "Errores de cada versión, según Users": la versión v3 supera la línea roja
#   del 5%, y Argo vuelve atrás.
./demos/load-deployment.sh k8s-canary

# Prometheus del clúster, con las métricas de cada pod de Users:
#
#    http://localhost:30090

# ---------------------------------------------------------------------------
# Logs de la entrada de despliegue
# ---------------------------------------------------------------------------

# Cada solicitud, con la instancia que la atendió y su versión
docker compose logs -f api-gateway | grep DEPLOY

# ---------------------------------------------------------------------------
# Tear down
# ---------------------------------------------------------------------------

# Detener los contenedores sin borrarlos: conservan su estado y se pueden volver
# a levantar con
#   docker compose --profile observability --profile feature-flags start
docker compose --profile observability --profile feature-flags stop

# Borrar el clúster de Kubernetes, con todo lo que tiene adentro, y sus imágenes
./demos/k8s-down.sh
docker rmi users-service:v1 users-service:v2 users-service:v3-bad
docker rmi $(docker images -q kindest/node)

# Borrar todo: contenedores, redes, volúmenes, imágenes, caché de build y las
# carpetas de las bases de datos
docker compose --profile observability --profile feature-flags down -v

docker rmi api-gateway:latest orders-service:latest users-service:latest products-service:latest
docker rmi legacy-erp:latest messaging-bridge:latest monolith:latest
docker rmi purchases-service:latest bff-web:latest bff-mobile:latest
docker rmi hashicorp/consul:1.21 apache/activemq-classic:6.1.7
docker rmi mysql:26 mongo:9 postgres:18 rabbitmq:4.4-management redis:8 nginx:1.25-alpine
docker rmi quay.io/keycloak/keycloak:26.8 mcr.microsoft.com/azure-storage/azurite:3.37.0 envoyproxy/envoy:v1.40-latest
docker rmi prom/prometheus:v3.15.1 grafana/grafana:13.2.5 grafana/k6:2.3.0
docker rmi unleashorg/unleash-server:8.2.1
docker image prune -f
docker volume prune -f
docker builder prune -f

rm -rf ./src/OrdersService/mysqldata
rm -rf ./src/ProductsService/mongodbdata
rm -rf ./src/UsersService/pgdata
rm -f gateway.crt
