{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "None"
    }
  },
  "AllowedHosts": "*",
  "Outbox": {
    "Enabled": false
  },
  "Worker": {
    "Enabled": false,
    "ProcessingDelayMs": 2000
  },
  "Projector": {
    "Enabled": false
  }
}
