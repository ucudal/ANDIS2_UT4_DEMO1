{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "OrdersService (.NET Web)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/OrdersService/bin/Debug/net10.0/OrdersService.dll",
      "args": [],
      "cwd": "${workspaceFolder}/OrdersService",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
