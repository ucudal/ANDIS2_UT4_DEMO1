# Parte 3: demos de los patrones de rendimiento, de la 10 a la 16
#
# Las demos de disponibilidad están en 02-availability.azcli, y las de
# seguridad, en 04-security.azcli.

# ---------------------------------------------------------------------------
# Levantar todos los servicios
# ---------------------------------------------------------------------------

# Estos comandos deben ejecutarse desde la raíz del repositorio. Usar el comando
# 'Azure CLI: Run Line in Terminal'.

# Inicia Docker si no está iniciado
docker desktop start

# Crear las carpetas que serán montadas como volúmenes para contener las bases
# de datos
mkdir -p src/UsersService/pgdata
mkdir -p src/ProductsService/mongodbdata
mkdir -p src/OrdersService/mysqldata

# Levantar todos los contenedores
docker compose build
docker compose up -d --wait

# ---------------------------------------------------------------------------
# Funciones auxiliares
# ---------------------------------------------------------------------------

# Seleccionar y ejecutar esta función en la terminal de la misma forma como se
# ejecutan los demás comandos de este archivo -o definirla en ~/.zshrc o
# ~/.bashrc para tenerla siempre-. Es una ayuda para ver las respuestas de los
# comandos 'curl' que son JSON como tabla, definir Requiere jq y column; ver los
# requisitos en README.md. Una lista de objetos se muestra con una columna por
# campo, y un objeto solo, como pares clave-valor. Para ver el resultado en JSON
# seleccionar sólo el comando 'curl' hasta antes del pipe '|'. Si después del
# JSON viene un número, como el código HTTP que agrega curl con -w, lo muestra
# al final, como HTTP 200.
table() {
  jq -r 'if type == "array"
         then (.[0] | keys_unsorted) as $k | ($k | @tsv), (.[] | [.[$k[]] | tostring] | @tsv)
         elif type == "number" then "HTTP \(.)"
         else to_entries[] | [.key, (.value | tostring)] | @tsv end' \
  | column -t -s $'\t'
}

# ---------------------------------------------------------------------------
# Observabilidad -opcional, recomendada para las demos-
# ---------------------------------------------------------------------------

# Levantar también Prometheus y Grafana. Si la aplicación ya está levantada,
# solo agrega los dos contenedores nuevos.
docker compose --profile observability up -d --wait

# Abrir en el navegador el dashboard de Grafana. Tiene los paneles que se
# mencionan en cada demo:
#
#    http://localhost:3000
#
# No pide usuario ni contraseña, y el dashboard es la página de inicio de
# Grafana, así que aparece directamente. Grafana
# lo carga al arrancar desde observability/grafana/dashboards/andis-demo.json;
# no hay que importarlo. Conviene dejarlo abierto durante todas las demos; se
# actualiza cada 5 segundos.
#
# Al final del título de cada panel, entre corchetes, están las demos que lo
# usan, por el número de su script en 'demos/': [Demo 1] es 01-retry.sh, y
# [Demos 1-3, 16] son 01, 02, 03 y 16. En los textos de este archivo los
# paneles se nombran sin ese agregado.
#
# Prometheus y el estado de cada target:
#
#     http://localhost:9090/targets
#
# Métricas de un servicio, tal como las lee Prometheus

curl http://localhost:8000/metrics

# ---------------------------------------------------------------------------
# Prueba de carga base, para las demos de rendimiento
# ---------------------------------------------------------------------------
# Lecturas mezcladas -detalle de Orders, Products y Users- a una tasa que sube
# hasta RATE solicitudes por segundo, se mantiene durante DURATION y baja.

docker compose run --rm k6 run -e RATE=50 -e DURATION=2m /scripts/load.js

# Resultado en consola: los thresholds p(95)<500 y rate<0.01 aparecen con ✓ si
# se cumple el objetivo de rendimiento; si no, k6 los marca con ✗ y termina con
# error.
#
# Resultado en Grafana: "Solicitudes por segundo, por servicio y código HTTP" y
# "Latencia p95 por servicio" muestran el throughput y la latencia de cada
# servicio; sirve como línea base para comparar antes y después de cada patrón
# de rendimiento.

# ---------------------------------------------------------------------------
# Demos de los patrones de rendimiento
# ---------------------------------------------------------------------------
# Los siguientes patrones agregan a la aplicación un exchange de eventos en
# RabbitMQ, andis.events; una caché de Products en Redis; y una vista
# materializada del detalle de las Orders, que mantiene orders-projector. Qué
# es un exchange y en qué se diferencia de una cola está explicado en
# PATTERNS.md, en la sección de Publisher/Subscriber.

# Cada patrón tiene un script en la carpeta 'demos/' que lo muestra paso a paso,
# con pocas solicitudes; la evidencia en los logs de Docker se ve con los
# comandos de este archivo. Los que dependen de la carga tienen además un
# escenario de k6 en la carpeta 'k6/', para verlos en Grafana a lo largo del
# tiempo. Los scripts y escenarios inyectan las fallas que necesitan y las
# quitan al terminar.

# Mientras corren, se puede tener abierto en otras terminales:
# 1. Los logs de Docker de orders-projector, products-service y orders-worker,
#    donde cada patrón deja su etiqueta: [PUB/SUB], [MATERIALIZED VIEW],
#    [CACHE-ASIDE] y [COMPETING CONSUMERS]

    docker compose logs -f --since 1s orders-projector products-service orders-worker

# 2. La salud de los servicios en vivo

    ./demos/monitor-health.sh

# ----------------------
# --- 10 Cache-Aside ---
# ----------------------
# Products busca primero en Redis. Si no está -miss-, lee MongoDB y lo guarda en
# Redis por 60 segundos; la próxima lectura sale de Redis -hit-. Al cambiar un
# Product, borra su clave de Redis. Para que la diferencia se note, se puede
# simular una base más lenta y apagar la caché, sin reiniciar.
#
# Apagar la caché y simular que cada lectura de MongoDB demora 200 ms. Luego
# leer el mismo Product 3 veces, mostrando solo el tiempo de respuesta: todas
# demoran algo más de 0.2 segundos, porque todas van a MongoDB.

curl -s -X PUT http://localhost/products/cache \
  -H "Content-Type: application/json" -d '{"enabled": false, "dbDelayMs": 200}' | jq

for i in 1 2 3; do
  curl -s -o /dev/null -w '%{time_total} s\n' http://localhost/products/60f7c2b5e1d3c2a1b8e4d123
done

# Prender la caché, con la base igual de lenta, y borrar la clave del Product
# en Redis por si quedó de una lectura anterior, para empezar con la caché
# vacía. Luego leer el Product otras 3 veces y comparar con el resultado
# anterior: la primera lectura demora lo mismo, porque es un miss y va a
# MongoDB; las siguientes demoran 2 o 3 milisegundos, porque son hits y salen
# de Redis.

curl -s -X PUT http://localhost/products/cache \
  -H "Content-Type: application/json" -d '{"enabled": true, "dbDelayMs": 200}' | jq

docker compose exec redis redis-cli DEL product:60f7c2b5e1d3c2a1b8e4d123

for i in 1 2 3; do
  curl -s -o /dev/null -w '%{time_total} s\n' http://localhost/products/60f7c2b5e1d3c2a1b8e4d123
done

# Ver el Product guardado en Redis: la clave product:{id}, su valor -el Product
# en JSON, con los nombres de los campos tal como están en la clase Product- y
# cuántos segundos le quedan antes de vencer, de los 60 con los que se guarda.

docker compose exec redis redis-cli KEYS '*'
docker compose exec redis redis-cli GET product:60f7c2b5e1d3c2a1b8e4d123
docker compose exec redis redis-cli TTL product:60f7c2b5e1d3c2a1b8e4d123

# En los logs de Products: los dos cambios de configuración de la caché y,
# después de prenderla, un miss y dos hits.

docker compose logs products-service --since 1m | grep '\[CACHE-ASIDE\]'

# Cambiar el nombre del Product de "Camisa" a "Camisa de lino". Products lo
# guarda en MongoDB y borra su clave de Redis, para que nadie lea el nombre
# viejo: la clave ya no existe -EXISTS devuelve 0-.

curl -s -X PUT http://localhost/products/60f7c2b5e1d3c2a1b8e4d123 \
  -H "Content-Type: application/json" -d '{"name": "Camisa de lino", "price": 1200.50}' | jq

docker compose exec redis redis-cli EXISTS product:60f7c2b5e1d3c2a1b8e4d123

# Leer el Product 2 veces, mostrando el Product y el tiempo de respuesta: la
# primera es un miss, demora algo más de 0.2 segundos y trae el nombre nuevo
# desde MongoDB; la segunda es un hit y trae el mismo nombre desde Redis.

curl -s -w '\n%{time_total} s\n' http://localhost/products/60f7c2b5e1d3c2a1b8e4d123
curl -s -w '\n%{time_total} s\n' http://localhost/products/60f7c2b5e1d3c2a1b8e4d123

# En los logs, al final, después de las líneas anteriores: la invalidación de
# la clave del Product y de la lista de Products, un miss y un hit.

docker compose logs products-service --since 1m | grep '\[CACHE-ASIDE\]'

# Detener Redis y leer el Product 2 veces: Products sigue respondiendo, pero
# las dos lecturas demoran algo más de 0.2 segundos, porque van a MongoDB. La
# caché mejora el rendimiento, pero Products no depende de ella para
# funcionar.

docker compose stop redis

curl -s -w '\n%{time_total} s\n' http://localhost/products/60f7c2b5e1d3c2a1b8e4d123
curl -s -w '\n%{time_total} s\n' http://localhost/products/60f7c2b5e1d3c2a1b8e4d123

# En los logs, al final: dos líneas "Redis no está conectado, se lee MongoDB",
# una por lectura.

docker compose logs products-service --since 1m | grep '\[CACHE-ASIDE\]'

# Volver a levantar Redis, devolverle al Product el nombre "Camisa" y dejar la
# caché con sus valores por defecto: prendida y sin demora.

docker compose start redis

curl -s -X PUT http://localhost/products/60f7c2b5e1d3c2a1b8e4d123 \
  -H "Content-Type: application/json" -d '{"name": "Camisa", "price": 1200.50}' | jq

curl -s -X DELETE http://localhost/products/cache | jq

# El siguiente script simula una base que demora 200 ms, lee el mismo Product
# varias veces, le cambia el nombre de "Camisa" a "Camisa de lino" y detiene
# Redis. Al terminar, le devuelve el nombre "Camisa".

./demos/10-cache-aside.sh

# Resultado en consola: la primera lectura demora unos 200 ms -miss- y las
# siguientes, 2 o 3 ms -hit-. Después de cambiar el nombre, la lectura siguiente
# es un miss y trae el nombre nuevo. Con Redis detenido, Products sigue
# respondiendo, a la velocidad de MongoDB. Logs de Docker: una línea
# [CACHE-ASIDE] por lectura, con hit o miss.

docker compose logs products-service --since 2m | grep '\[CACHE-ASIDE\]'

# Bajo carga: 50 lecturas por segundo, 30 segundos con la caché apagada y 30
# segundos prendida.

docker compose run --rm k6 run /scripts/cache-aside.js

# Resulado en la consola: el threshold de la fase con caché, p(95)<50, aparece
# con ✓.
#
# Resultado en Grafana:
# - "Lecturas de la caché de Products, por resultado": "disabled" en unas 50
#   por segundo en la primera fase; en la segunda, "hit" en unas 50 por segundo
#   y algún "miss" al empezar, uno por Product.
# - "Latencia p95 por servicio": products-service baja de más de 100 ms a unos
#   5 ms cuando se prende la caché.
# - "Latencia p95 vista por k6, por endpoint": "product sin caché" por encima de
#   100 ms; "product con caché" empieza alto, por los primeros miss, y baja a
#   unos 5 ms.
# El script de la demo hace pocas lecturas: en Grafana se ve solo bajo carga.

# ------------------------------------
# --- 11 Queue-Based Load Leveling ---
# ------------------------------------
# POST /orders/ solo guarda la Order y responde; el trabajo de verificar el User
# y el Product lo hacen los workers desde la cola, a su ritmo. La cola absorbe
# el pico: Users y Products reciben como máximo una llamada por réplica del
# worker, lleguen las Orders que lleguen.
#
# A continuación e detienen los workers, se crea un pico de Orders que queda en
# la cola, y después se levantan los workers de a poco para ver a qué ritmo la
# vacían. En Grafana se ve en el panel "Cola orders.process": "esperando" es la
# cantidad de mensajes en la cola, "en proceso" los que un worker tomó y todavía
# no confirmó, y "consumidores" la cantidad de workers conectados. Y en "Orders
# procesadas por segundo, por réplica", una franja por cada réplica que está
# procesando. Grafana se actualiza cada 5 segundos.
#
# Detener las tres réplicas del worker. En Grafana, "consumidores" baja a 0.

docker compose stop orders-worker

# Crear un pico de 30 Orders. Se crean directamente en orders-service, en el
# puerto 8000, sin pasar por el gateway, para no chocar con su límite de
# POST /orders/ -ver Throttling-. Cada una muestra el código HTTP y el tiempo
# de respuesta: todas responden 202 en pocos milisegundos -la primera puede
# demorar un poco más-, aunque no haya ningún worker, porque POST /orders/ solo
# guarda la Order y deja el mensaje para la cola.

for i in $(seq 30); do
  curl -s -o /dev/null -w '%{http_code} %{time_total} s\n' -X POST http://localhost:8000/orders/ \
    -H "Content-Type: application/json" \
    -d '{"userId": 2, "productId": "60f7c2b5e1d3c2a1b8e4d124", "quantity": 1}'
done

# Esperar unos segundos y ver la cola: los 30 mensajes esperan, sin
# consumidores. Si se consulta enseguida puede haber menos, porque los mensajes
# llegan a la cola a través del outbox, que publica cada segundo -ver
# Transactional Outbox-. En Grafana, "esperando" sube a 30.

docker compose exec rabbitmq rabbitmqctl list_queues -q name messages consumers | column -t

# Levantar una sola réplica del worker y guardar su nombre en una variable.

worker=$(docker compose ps -a --format '{{.Name}}' orders-worker | head -1)
docker start $worker

# Mirar la cola unas 10 veces, cada 2 o 3 segundos: con una sola réplica, que
# demora 2 segundos por Order, baja de a 1 mensaje por vez. A ese ritmo
# tardaría más de un minuto en vaciarse. En Grafana, "esperando" baja en línea recta,
# con poca pendiente, y "en proceso" queda en 1.

for i in $(seq 10); do
  docker compose exec rabbitmq rabbitmqctl list_queues -q --no-table-headers name messages consumers \
    | awk -v t="$(date +%T)" '$1 == "orders.process" { print t "  mensajes: " $2 "  consumidores: " $3 }'
  sleep 2
done

# Crear otro pico de 30 Orders. Levantar las otras dos réplicas -docker compose
# start levanta las que estén detenidas- y volver a mirar la cola: con tres
# réplicas baja de a unos 3 mensajes por vez, el triple de rápido, y se vacía en
# unos 15 segundos. En Grafana, "consumidores" y "en proceso" suben a 3,
# "esperando" baja con más pendiente, y en "Orders procesadas por segundo, por
# réplica" aparecen tres franjas.

for i in $(seq 30); do
  curl -s -o /dev/null -w '%{http_code} %{time_total} s\n' -X POST http://localhost:8000/orders/ \
    -H "Content-Type: application/json" \
    -d '{"userId": 2, "productId": "60f7c2b5e1d3c2a1b8e4d124", "quantity": 1}'
done

docker compose start orders-worker

for i in $(seq 10); do
  docker compose exec rabbitmq rabbitmqctl list_queues -q --no-table-headers name messages consumers \
    | awk -v t="$(date +%T)" '$1 == "orders.process" { print t "  mensajes: " $2 "  consumidores: " $3 }'
  sleep 2
done

# En ningún momento las solicitudes esperaron a los workers: el pico lo absorbió
# la cola, y Users y Products recibieron como máximo una llamada a la vez por
# réplica, lleguen las Orders que lleguen. Sin la cola, cada POST /orders/
# habría tenido que esperar a que se procesara su Order, y Users y Products
# habrían recibido las 30 llamadas a la vez.
#
# El siguiente script crea 30 Orders a la vez, directamente en orders-service:
# el Throttling por cliente del gateway rechazaría el pico antes de llegar a la
# cola. Tarda unos 25 segundos.

./demos/11-queue-based-load-leveling.sh

# Resultado en consola: las 30 responden 202 en pocos milisegundos; la cola baja
# de a 3 mensajes cada 2 segundos, uno por réplica, hasta vaciarse.

# Bajo carga: 10 POST por segundo durante 10 segundos.

docker compose run --rm k6 run /scripts/load-leveling.js

# Resultado en onsola: el threshold de "create order", p(95)<200, aparece con ✓.
#
# Resultado en Grafana:
# - "Cola orders.process": "esperando" sube a unos 80 durante el pico y baja de
#   forma pareja durante algo más de un minuto; "en proceso" queda en 3, uno
#   por réplica.
# - "Latencia p95 vista por k6, por endpoint": "create order" se mantiene por
#   debajo de 30 ms durante todo el pico.

# ---------------------------------------------
# --- 12 Competing Consumers: escalabilidad ---
# ---------------------------------------------
# El mismo patrón de la demo 07, en 02-availability.azcli, ahora como patrón de
# rendimiento: el throughput crece agregando réplicas de orders-worker, sin
# cambiar el código.
#
# Ver las réplicas de orders-worker y la cola orders.process: hay 3 réplicas,
# y la cola tiene 3 consumidores, uno por réplica.

docker compose ps --format 'table {{.Name}}\t{{.Status}}' orders-worker
docker compose exec rabbitmq rabbitmqctl list_queues -q name messages consumers | column -t

# Con 3 réplicas, crear un pico de 30 Orders y medir cuánto tardan en
# procesarse. Seleccionar y ejecutar el bloque completo: crea las Orders
# directamente en orders-service, en el puerto 8000, sin pasar por el límite de
# POST del gateway -ver Throttling-, y después muestra cada 2 segundos cuántas
# siguen Pending, con los segundos transcurridos desde que se crearon. Cada
# réplica demora 2 segundos por Order: las 30 tardan entre 20 y 23 segundos.

start=$(date +%s)
for i in $(seq 30); do
  curl -s -o /dev/null -X POST http://localhost:8000/orders/ \
    -H "Content-Type: application/json" \
    -d '{"userId": 2, "productId": "60f7c2b5e1d3c2a1b8e4d125", "quantity": 1}'
done
while :; do
  pending=$(curl -s http://localhost/orders/ | jq '[.[] | select(.status == "Pending")] | length')
  echo "$(( $(date +%s) - start )) s  Pending: $pending"
  [ "$pending" = 0 ] && break
  sleep 2
done

# Cuántas Orders confirmó cada réplica desde que empezó el pico -la variable
# start la guardó el bloque anterior-: unas 10 cada una.

docker compose logs --since $start orders-worker | grep 'Confirmed' | awk '{ print $1 }' | sort | uniq -c

# Escalar a 6 réplicas, sin cambiar el código ni la configuración: Docker crea
# 3 contenedores más de la misma imagen. --wait espera a que estén sanos. Las
# nuevas réplicas se conectan a la misma cola: esperar unos segundos y ver que
# la cola tiene 6 consumidores. En Grafana, "consumidores" sube a 6 en el panel
# "Cola orders.process".

docker compose up -d --scale orders-worker=6 --wait orders-worker

docker compose ps --format 'table {{.Name}}\t{{.Status}}' orders-worker
docker compose exec rabbitmq rabbitmqctl list_queues -q name messages consumers | column -t

# Con 6 réplicas, crear otro pico de 30 Orders y medir, con el mismo bloque, y
# comparar con el resultado anterior: ahora tardan entre 11 y 13 segundos,
# cerca de la mitad, porque el trabajo se reparte entre el doble de
# consumidores.

start=$(date +%s)
for i in $(seq 30); do
  curl -s -o /dev/null -X POST http://localhost:8000/orders/ \
    -H "Content-Type: application/json" \
    -d '{"userId": 2, "productId": "60f7c2b5e1d3c2a1b8e4d125", "quantity": 1}'
done
while :; do
  pending=$(curl -s http://localhost/orders/ | jq '[.[] | select(.status == "Pending")] | length')
  echo "$(( $(date +%s) - start )) s  Pending: $pending"
  [ "$pending" = 0 ] && break
  sleep 2
done

# Cuántas Orders confirmó cada réplica desde que empezó este pico: unas 5 cada
# una, entre las 6. En Grafana, "Orders procesadas por segundo, por réplica"
# muestra 6 franjas, más finas que las anteriores, pero que suman el doble.

docker compose logs --since $start orders-worker | grep 'Confirmed' | awk '{ print $1 }' | sort | uniq -c

# Volver a 3 réplicas: Docker detiene y borra las 3 que agregó.

docker compose up -d --scale orders-worker=3 --wait orders-worker

# El siguiente script procesa 30 Orders con 3 réplicas, escala a 6 y procesa
# otras 30. Al terminar vuelve a 3 réplicas. Tarda cerca de un minuto.

./demos/12-competing-consumers-scaling.sh

# Resultado en consola: con 3 réplicas, unos 21 segundos; con 6, unos 12. Bajo
# carga, con 6 réplicas:

docker compose up -d --scale orders-worker=6
docker compose run --rm k6 run /scripts/load-leveling.js
docker compose up -d --scale orders-worker=3

# Resulado en Grafana:
# - "Cola orders.process": "consumidores" sube a 6 y "en proceso" a 6; la cola
#   se vacía en unos 40 segundos, cerca de la mitad que con 3 réplicas.
# - "Orders procesadas por segundo, por réplica": 6 franjas, una por réplica,
#   cada una identificada por el id de su contenedor.

# -------------------------------
# --- 13 Publisher/Subscriber ---
# -------------------------------
# Orders, Users y Products publican eventos en el exchange andis.events. Cada
# suscriptor tiene su propia cola y la enlaza con las claves que le interesan:
# orders.process, del worker, recibe order.created; orders.details-view, del
# proyector, recibe order.*, user.updated y product.updated. Los enlaces se ven
# en la consola de RabbitMQ, http://localhost:15672, en Exchanges >
# andis.events. La diferencia entre el exchange y las colas está explicada en
# PATTERNS.md, en la sección de Publisher/Subscriber.
#
# Ver los enlaces del exchange andis.events: cada cola y las claves de ruteo
# con las que la enlazó su suscriptor. Se leen de la API de la consola de
# RabbitMQ, con usuario y contraseña guest.

curl -s -u guest:guest http://localhost:15672/api/exchanges/%2F/andis.events/bindings/source \
  | jq '[.[] | {cola: .destination, clave: .routing_key}]' | table

# Crear una Order.

curl -s -X POST http://localhost/orders/ \
  -H "Content-Type: application/json" \
  -d '{"userId": 2, "productId": "60f7c2b5e1d3c2a1b8e4d125", "quantity": 1}' | jq

# Esperar unos 3 segundos y ver las últimas 4 líneas de los logs de los dos
# suscriptores: orders-worker procesa la Order porque recibió order.created, y
# orders-projector recibió order.created y, cuando el worker la confirmó,
# order.confirmed. Orders publicó cada evento una sola vez, sin saber cuántos
# suscriptores había. docker compose logs muestra las líneas agrupadas por
# contenedor, no en orden cronológico: con -t cada línea trae la hora, sort las
# ordena por esa columna, y sed borra la hora antes de mostrarlas. Como la
# salida de grep pasa por otros comandos, --color=always hace que igual
# resalte la etiqueta entre corchetes.

docker compose logs -t orders-worker orders-projector \
  | grep --color=always -E '\[PUB/SUB\]|\[COMPETING CONSUMERS\]' \
  | sort -k3 | tail -4 | sed -E 's/ [0-9T:.-]+Z / /'

# Cambiar el nombre del Product 60f7c2b5e1d3c2a1b8e4d125 de "Zapatos" a
# "Zapatillas".

curl -s -X PUT http://localhost/products/60f7c2b5e1d3c2a1b8e4d125 \
  -H "Content-Type: application/json" -d '{"name": "Zapatillas", "price": 3500.75}' | jq

# Las últimas 2 líneas de los logs de Products y de orders-projector: Products
# publica product.updated, y orders-projector lo recibe y actualiza el nombre
# en la vista. El worker no lo recibe: como se vio en los enlaces, no está
# suscripto a ese evento. En los logs, la recepción puede aparecer antes que
# la publicación, porque Products la anota después de publicar.

docker compose logs -t products-service orders-projector \
  | grep --color=always '\[PUB/SUB\]' \
  | sort -k3 | tail -2 | sed -E 's/ [0-9T:.-]+Z / /'

# Agregar un suscriptor nuevo sin tocar el código de ningún servicio: crear la
# cola spy y enlazarla al exchange con la clave #, que en un exchange de tipo
# topic recibe todos los eventos. Volver a ver los enlaces: aparece la cola
# spy. La cola es durable porque RabbitMQ 4 no admite colas no durables
# compartidas; al final de la demo se borra. La API responde sin cuerpo, así
# que cada comando muestra solo el código HTTP: 201 al crear la cola -204 si
# ya existía- y 201 al crear el enlace. En Grafana, la cola spy aparece en el
# panel "Mensajes en cada cola".

curl -s -o /dev/null -w '%{http_code}\n' -u guest:guest -X PUT http://localhost:15672/api/queues/%2F/spy \
  -H "Content-Type: application/json" -d '{"durable": true}'

curl -s -o /dev/null -w '%{http_code}\n' -u guest:guest -X POST http://localhost:15672/api/bindings/%2F/e/andis.events/q/spy \
  -H "Content-Type: application/json" -d '{"routing_key": "#"}'

curl -s -u guest:guest http://localhost:15672/api/exchanges/%2F/andis.events/bindings/source \
  | jq '[.[] | {cola: .destination, clave: .routing_key}]' | table

# Generar eventos de los tres publicadores: crear una Order, devolverle al
# Product el nombre "Zapatos" y cambiar el nombre del User 2 de "bob" a
# "roberto" -Users es SOAP-.

curl -s -X POST http://localhost/orders/ \
  -H "Content-Type: application/json" \
  -d '{"userId": 2, "productId": "60f7c2b5e1d3c2a1b8e4d125", "quantity": 1}' | jq

curl -s -X PUT http://localhost/products/60f7c2b5e1d3c2a1b8e4d125 \
  -H "Content-Type: application/json" -d '{"name": "Zapatos", "price": 3500.75}' | jq

curl -s -X POST http://localhost/users/UserService.svc \
  -H "Content-Type: text/xml; charset=utf-8" \
  -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/UpdateUser"' \
  -d '<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
        <soap:Body>
          <UpdateUser xmlns="http://ucu.edu.uy/andis/users">
            <id>2</id>
            <name>roberto</name>
            <email>bob@example.com</email>
          </UpdateUser>
        </soap:Body>
      </soap:Envelope>' | xmllint --format -

# Esperar unos 3 segundos y leer los mensajes de la cola spy: tiene una copia
# de cada evento -order.created, order.confirmed, product.updated y
# user.updated-, los mismos que recibieron los otros suscriptores. Ningún
# publicador cambió: no saben que spy existe. Los eventos de la Order pueden
# aparecer después de los otros, aunque se creó primero, porque Orders los
# publica a través del outbox, que publica cada segundo -ver Transactional
# Outbox-.

curl -s -u guest:guest -X POST http://localhost:15672/api/queues/%2F/spy/get \
  -H "Content-Type: application/json" \
  -d '{"count": 20, "ackmode": "ack_requeue_false", "encoding": "auto"}' \
  | jq '[.[] | {clave: .routing_key, mensaje: .payload}]' | table

# Borrar la cola spy -responde 204- y devolverle al User 2 el nombre "bob".

curl -s -o /dev/null -w '%{http_code}\n' -u guest:guest -X DELETE http://localhost:15672/api/queues/%2F/spy

curl -s -X POST http://localhost/users/UserService.svc \
  -H "Content-Type: text/xml; charset=utf-8" \
  -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/UpdateUser"' \
  -d '<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
        <soap:Body>
          <UpdateUser xmlns="http://ucu.edu.uy/andis/users">
            <id>2</id>
            <name>bob</name>
            <email>bob@example.com</email>
          </UpdateUser>
        </soap:Body>
      </soap:Envelope>' | xmllint --format -

# El siguiente script muestra los enlaces, crea una Order y cambia el nombre
# del Product 60f7c2b5e1d3c2a1b8e4d125 de "Zapatos" a "Zapatillas" y el del
# User 2 de "bob" a "roberto", mostrando qué suscriptor recibe cada evento. Al
# terminar, les devuelve sus nombres.

./demos/13-publisher-subscriber.sh

# Resultado en consola: order.created llega al worker y al proyector;
# product.updated y user.updated, solo al proyector, que actualiza los nombres
# en la vista. Logs de Docker:

docker compose logs orders-projector --since 2m | grep '\[PUB/SUB\]'
docker compose logs users-service products-service --since 2m | grep '\[PUB/SUB\]'

# Grafana:
# - "Mensajes en cada cola": durante el paso a paso, la cola spy aparece al
#   crearla y sube de a uno con cada evento, porque nadie la consume; vuelve a
#   0 al leer sus mensajes y desaparece al borrarla. orders.process y
#   orders.details-view quedan en 0: sus suscriptores procesan cada evento
#   enseguida. El script no crea la cola spy, así que con él solo se ven esas
#   dos.
# - Los enlaces se ven en la consola de RabbitMQ.

# -------------------------------------
# --- 14 Asynchronous Request-Reply ---
# -------------------------------------
# POST /orders/ responde 202 Accepted con Location: /orders/{id}/status y
# Retry-After: 2. El estado responde 200 mientras la Order está Pending, y 303
# See Other a la Order cuando un worker la confirmó o la rechazó.
#
# Para tener tiempo de ver la Order Pending, detener los workers: mientras no
# haya ninguno, nadie la procesa.

docker compose stop orders-worker

# Crear una Order. Con -i, curl muestra los encabezados de la respuesta, y con
# -w, el tiempo que demoró. Orders responde enseguida, aunque no haya ningún
# worker, con:
# - 202 Accepted: recibió el pedido, pero todavía no está listo.
# - Location: dónde consultar el estado, /orders/{id}/status.
# - Retry-After: cuántos segundos esperar antes de consultarlo, 2.
# El cliente no queda esperando a que se procese la Order. La respuesta se
# guarda en una variable, para mostrarla y sacar de ella la dirección de
# Location, que usan los comandos siguientes.

response=$(curl -s -i -w '\n%{time_total} s' -X POST http://localhost/orders/ \
  -H "Content-Type: application/json" \
  -d '{"userId": 2, "productId": "60f7c2b5e1d3c2a1b8e4d123", "quantity": 1}')
echo "$response"
location=$(echo "$response" | grep -i '^location:' | tr -d '\r' | awk '{print $2}')
echo "$location"

# Consultar el estado en la dirección de Location, igual que haría un cliente:
# responde 200 con el estado, Pending, y otra vez Retry-After: el cliente tiene
# que volver a consultar más tarde. Se puede repetir varias veces: mientras no
# haya workers, la respuesta es siempre la misma.

curl -s -i "http://localhost$location"

# Levantar los workers. Uno de ellos procesa la Order en unos 2 segundos.

docker compose start orders-worker

# Esperar unos segundos y volver a consultar el estado: ahora responde 303 See
# Other, sin cuerpo, con Location apuntando a la Order, /orders/{id}. El
# resultado está ahí.

curl -s -i "http://localhost$location"

# Lo mismo, pero con -L curl sigue la redirección del 303 por su cuenta, como
# haría un cliente, y muestra directamente la Order, confirmada.

curl -s -L "http://localhost$location" | table

# El siguiente script crea una Order y consulta su estado respetando
# Retry-After hasta el 303.

./demos/14-asynchronous-request-reply.sh

# Resultado en consola: el 202 con sus encabezados; dos o tres consultas con 200
# Pending, una cada 2 segundos; el 303 con Location: /orders/{id}; y la Order
# confirmada. Grafana: no hay un panel propio.

# ---------------
# --- 15 CQRS ---
# ---------------
# CQRS separa las operaciones que cambian datos -comandos- de las que solo los
# leen -consultas-, y le da a cada lado sus propias tablas.
# - Comandos: crear una Order -con POST /orders/- y procesarla -con el worker-.
#   Escriben el estado en 'orders', el evento en 'order_events' y el mensaje
#   para RabbitMQ en 'outbox_messages'. 'orders' tiene solo ids, sin nombres.
# - Consulta: GET /orders/user/{userId}/details/view lee 'order_details', que
#   ningún comando escribe: la mantiene orders-projector a partir de los
#   eventos -ver Materialized View-. Ya tiene los nombres copiados, así que
#   responde con una sola consulta a MySQL, sin llamar a Users ni a Products.
# Para comparar sigue estando la consulta de las demos 01 a 04,
# GET /orders/user/{userId}/details, que lee 'orders', la tabla de los comandos,
# y le pide los nombres a Users y a Products en cada consulta.
#
# Ver de dónde sale cada consulta en la base de Orders. Del lado de los
# comandos, la tabla 'orders' tiene solo ids: para armar el detalle hay que
# pedirle a Users el nombre del cliente y a Products el nombre del producto.
# Del lado de las consultas, la tabla 'order_details' ya tiene los nombres
# copiados.

docker compose exec orders-db mysql --default-character-set=utf8mb4 -u ordersusr -pPa55w0rd ordersdb \
  -e "SELECT * FROM orders WHERE user_id = 1"
docker compose exec orders-db mysql --default-character-set=utf8mb4 -u ordersusr -pPa55w0rd ordersdb \
  -e "SELECT * FROM order_details WHERE user_id = 1"

# Hacer la misma consulta por los dos lados: la respuesta es la misma.

curl -s http://localhost/orders/user/1/details | table
curl -s http://localhost/orders/user/1/details/view | table

# Hacer que Users y Products demoren 200 ms en responder, como si estuvieran
# cargados o lejos. Sin esa demora, en esta demo todo corre en la misma máquina
# y la diferencia entre las dos consultas es de pocos milisegundos.

curl -s -X PUT http://localhost/users/chaos \
  -H 'Content-Type: application/json' \
  -d '{"failureRate": 0, "delayMs": 200}' | jq
curl -s -X PUT http://localhost/products/chaos \
  -H 'Content-Type: application/json' \
  -d '{"failureRate": 0, "delayMs": 200}' | jq

# Comparar el tiempo de respuesta, 3 veces cada una: la síncrona demora más de
# medio segundo, porque llama a Users y a Products por cada Order, y cada
# llamada demora 200 ms; la vista, pocos milisegundos, porque es una sola
# consulta a MySQL y no llama a nadie.

for i in 1 2 3; do
  curl -s -o /dev/null -w 'details:      %{time_total} s\n' http://localhost/orders/user/1/details
done
for i in 1 2 3; do
  curl -s -o /dev/null -w 'details/view: %{time_total} s\n' http://localhost/orders/user/1/details/view
done

# Hacer que Products falle siempre: la síncrona muestra "no disponible" en
# lugar del nombre del producto -con "error HTTP 503" o, si el Circuit Breaker
# ya se abrió, con "circuito abierto"-; la vista sigue mostrando los nombres,
# porque ya están copiados.

curl -s -X PUT http://localhost/products/chaos \
  -H 'Content-Type: application/json' \
  -d '{"failureRate": 1, "delayMs": 0}' | jq

curl -s http://localhost/orders/user/1/details | table
curl -s http://localhost/orders/user/1/details/view | table

# Reparar Users y Products.

curl -s -X DELETE http://localhost/users/chaos | jq
curl -s -X DELETE http://localhost/products/chaos | jq

# El costo de la vista es la consistencia eventual: 'order_details' la mantiene
# orders-projector a partir de los eventos, y una Order recién creada tarda en
# llegar. Para tener tiempo de verlo, detener el proyector.

docker compose stop orders-projector

# Contar las Orders del User 2 por los dos lados, crear una Order y volver a
# contar: la síncrona ya la tiene, porque lee la tabla 'orders'; la vista no,
# porque el evento order.created espera en la cola orders.details-view a que
# vuelva el proyector.

curl -s http://localhost/orders/user/2/details | jq length
curl -s http://localhost/orders/user/2/details/view | jq length

curl -s -X POST http://localhost/orders/ \
  -H "Content-Type: application/json" \
  -d '{"userId": 2, "productId": "60f7c2b5e1d3c2a1b8e4d123", "quantity": 1}' | jq

curl -s http://localhost/orders/user/2/details | jq length
curl -s http://localhost/orders/user/2/details/view | jq length

# Levantar el proyector, esperar unos segundos y volver a contar: la vista se
# puso al día y las dos consultas devuelven la misma cantidad. Sin detener el
# proyector la demora es de uno o dos segundos.

docker compose start orders-projector

curl -s http://localhost/orders/user/2/details | jq length
curl -s http://localhost/orders/user/2/details/view | jq length

# El siguiente script hace la misma consulta por los dos lados, sin fallas y con
# Products demorando 300 ms, y después muestra la consistencia eventual.

./demos/15-cqrs.sh

# Resultado en consola: sin fallas, la síncrona demora unos 100 ms y la vista,
# unos 3. Con Products lento, la síncrona pasa a casi 2 segundos y la vista no
# cambia. Justo después de crear una Order, la síncrona ya la tiene y la vista
# todavía no.

# Bajo carga, se corre load.js de las dos formas y se comparan en Grafana:

docker compose run --rm k6 run -e DETAILS=live /scripts/load.js
docker compose run --rm k6 run -e DETAILS=view /scripts/load.js

# Resulado en Grafana, comparando la primera corrida con la segunda:
# - "Latencia p95 del detalle de Orders: síncrono contra vista": la línea
#   "orders/user/{userId}/details/view" queda por debajo de la de
#   "orders/user/{userId}/details". Sin fallas la diferencia es de pocos
#   milisegundos; con Products lento, como en el script, sería de segundos.
# - "Latencia p95 vista por k6, por endpoint": lo mismo visto por el cliente,
#   "details" en la primera corrida y "details view" en la segunda.
# - "Resultado de las llamadas a cada dependencia": en la segunda corrida todas
#   las series bajan a 0, porque con la vista Orders no llama a Users ni a
#   Products.

# ----------------------------
# --- 16 Materialized View ---
# ----------------------------
# 'order_details' guarda el detalle de cada Order con el nombre del cliente y
# del producto ya copiados. La mantiene orders-projector a partir de los
# eventos: al recibir order.created busca los nombres una sola vez; con
# order.confirmed y order.rejected actualiza el estado; con user.updated y
# product.updated, los nombres.
#
# Ver las filas del User 1 en 'order_details': cada una tiene el nombre del
# cliente y el del producto, y updated_at, la última vez que el proyector la
# cambió.

docker compose exec orders-db mysql --default-character-set=utf8mb4 -u ordersusr -pPa55w0rd ordersdb \
  -e "SELECT * FROM order_details WHERE user_id = 1"

# Cambiar el nombre del Product 60f7c2b5e1d3c2a1b8e4d123 de "Camisa" a
# "Camisa de lino". Products publica product.updated, y el proyector actualiza
# el nombre en todas las filas de 'order_details' que tienen ese Product.

curl -s -X PUT http://localhost/products/60f7c2b5e1d3c2a1b8e4d123 \
  -H "Content-Type: application/json" -d '{"name": "Camisa de lino", "price": 1200.50}' | jq

# En el último log del proyector: en cuántas filas actualizó el nombre.

docker compose logs orders-projector | grep --color=always '\[MATERIALIZED VIEW\]' | tail -1

# En 'order_details' la Order 1 ya dice "Camisa de lino", con un updated_at
# nuevo; la Order 3, de otro Product, no cambió.

docker compose exec orders-db mysql --default-character-set=utf8mb4 -u ordersusr -pPa55w0rd ordersdb \
  -e "SELECT * FROM order_details WHERE user_id = 1"

# Cambiar el nombre del User 1 de "alice" a "alicia" -Users es SOAP-. Users
# publica user.updated, y el proyector actualiza el nombre del cliente en todas
# sus filas.

curl -s -X POST http://localhost/users/UserService.svc \
  -H "Content-Type: text/xml; charset=utf-8" \
  -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/UpdateUser"' \
  -d '<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
        <soap:Body>
          <UpdateUser xmlns="http://ucu.edu.uy/andis/users">
            <id>1</id>
            <name>alicia</name>
            <email>alice@example.com</email>
          </UpdateUser>
        </soap:Body>
      </soap:Envelope>' | xmllint --format -

docker compose logs orders-projector | grep --color=always '\[MATERIALIZED VIEW\]' | tail -1

# La consulta que lee la vista ya trae los nombres nuevos, sin haberle
# preguntado nada a Users ni a Products.

curl -s http://localhost/orders/user/1/details/view | table

# Crear una Order para el User 2 y guardar su id en una variable. El proyector
# recibe order.created, le pide a Users y a Products los nombres una sola vez
# y agrega la fila; después recibe order.confirmed y actualiza solo el estado.

id=$(curl -s -X POST http://localhost/orders/ \
  -H "Content-Type: application/json" \
  -d '{"userId": 2, "productId": "60f7c2b5e1d3c2a1b8e4d124", "quantity": 1}' | jq .id)
echo "$id"

# Esperar unos 3 segundos y ver los dos últimos logs del proyector: la fila
# agregada con los nombres, y el cambio de estado.

docker compose logs orders-projector | grep --color=always '\[MATERIALIZED VIEW\]' | tail -2

docker compose exec orders-db mysql --default-character-set=utf8mb4 -u ordersusr -pPa55w0rd ordersdb \
  -e "SELECT * FROM order_details WHERE order_id = $id"

# Devolverle al Product el nombre "Camisa" y al User 1 el nombre "alice". El
# proyector vuelve a actualizar la vista.

curl -s -X PUT http://localhost/products/60f7c2b5e1d3c2a1b8e4d123 \
  -H "Content-Type: application/json" -d '{"name": "Camisa", "price": 1200.50}' | jq

curl -s -X POST http://localhost/users/UserService.svc \
  -H "Content-Type: text/xml; charset=utf-8" \
  -H 'SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/UpdateUser"' \
  -d '<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
        <soap:Body>
          <UpdateUser xmlns="http://ucu.edu.uy/andis/users">
            <id>1</id>
            <name>alice</name>
            <email>alice@example.com</email>
          </UpdateUser>
        </soap:Body>
      </soap:Envelope>' | xmllint --format -

# Qué pasa con la vista cuando Users o Products fallan, y cuando el proyector
# está detenido, se vio en la demo 15, CQRS. El siguiente script lo repite.
#
# El siguiente script cambia el nombre del Product 60f7c2b5e1d3c2a1b8e4d123 de
# "Camisa" a "Camisa de lino", hace fallar a Products y detiene el proyector
# mientras se crea una Order. Al terminar, le devuelve el nombre "Camisa".

./demos/16-materialized-view.sh

# Resultado en consola: la vista refleja el nombre nuevo. Con Products fallando,
# la consulta síncrona responde "no disponible" y la vista, con los nombres. Con
# el proyector detenido, la Order se confirma pero no aparece en la vista, y sus
# eventos esperan en la cola; al levantarlo, la vista se pone al día. Logs de
# Docker:

docker compose logs orders-projector --since 2m | grep '\[MATERIALIZED VIEW\]'

# Para ver la vista directamente en la base:

docker compose exec orders-db mysql --default-character-set=utf8mb4 -u ordersusr -pPa55w0rd ordersdb \
  -e "SELECT * FROM order_details ORDER BY order_id DESC LIMIT 10"

# Resulado en Grafana:
# - "Cola orders.details-view": durante los 15 segundos en que el proyector está
#   detenido, "consumidores" baja a 0 y "esperando" sube a 2, los eventos
#   order.created y order.confirmed de la Order nueva; al levantarlo, vuelven a
#   1 y a 0.
# - "Patrones de resiliencia prendidos en Orders": los cuatro bajan a 0 mientras
#   Products falla, y vuelven a 1 al terminar la demo.
# - "Salud de los servicios": orders-projector en gris, no responde, durante los
#   15 segundos en que está detenido.

# ---------------------------------------------------------------------------
# Tear down
# ---------------------------------------------------------------------------

# Detener los contenedores sin borrarlos: conservan su estado y se pueden volver
# a levantar con docker compose --profile observability start
docker compose --profile observability stop

# Borrar todo: contenedores, redes, volúmenes, imágenes, caché de build y las
# carpetas de las bases de datos
docker compose --profile observability down -v

docker rmi api-gateway:latest orders-service:latest users-service:latest products-service:latest
docker rmi mysql:26 mongo:9 postgres:18 rabbitmq:4.4-management redis:8 nginx:1.25-alpine
docker rmi quay.io/keycloak/keycloak:26.8 mcr.microsoft.com/azure-storage/azurite:3.37.0 envoyproxy/envoy:v1.40-latest
docker rmi prom/prometheus:v3.15.1 grafana/grafana:13.2.5 grafana/k6:2.3.0
docker image prune -f
docker volume prune -f
docker builder prune -f

rm -rf ./src/OrdersService/mysqldata
rm -rf ./src/ProductsService/mongodbdata
rm -rf ./src/UsersService/pgdata
