@UsersService_HostAddress = http://localhost

### Get the WSDL
GET {{UsersService_HostAddress}}/users/UserService.svc?wsdl

### Create a user
POST {{UsersService_HostAddress}}/users/UserService.svc
Content-Type: text/xml; charset=utf-8
SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/CreateUser"

<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Body>
    <CreateUser xmlns="http://ucu.edu.uy/andis/users">
      <name>julia</name>
      <email>julia@example.com</email>
    </CreateUser>
  </soap:Body>
</soap:Envelope>

### List all users
POST {{UsersService_HostAddress}}/users/UserService.svc
Content-Type: text/xml; charset=utf-8
SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/ListUsers"

<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Body>
    <ListUsers xmlns="http://ucu.edu.uy/andis/users" />
  </soap:Body>
</soap:Envelope>

### Get user by ID
POST {{UsersService_HostAddress}}/users/UserService.svc
Content-Type: text/xml; charset=utf-8
SOAPAction: "http://ucu.edu.uy/andis/users/IUserService/GetUser"

<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Body>
    <GetUser xmlns="http://ucu.edu.uy/andis/users">
      <id>1</id>
    </GetUser>
  </soap:Body>
</soap:Envelope>

###
