@OrdersService_HostAddress = http://localhost

### Create an order
POST {{OrdersService_HostAddress}}/orders/
Content-Type: application/json

{
  "userId": 2,
  "productId": "60f7c2b5e1d3c2a1b8e4d124",
  "quantity": 2
}

### List all orders
GET {{OrdersService_HostAddress}}/orders/

### Get an order
GET {{OrdersService_HostAddress}}/orders/1

### Get the status of an order (Asynchronous Request-Reply)
GET {{OrdersService_HostAddress}}/orders/1/status

### Get all orders for a user (with details)
GET {{OrdersService_HostAddress}}/orders/user/1/details

### Get all orders for a user from the materialized view (CQRS)
GET {{OrdersService_HostAddress}}/orders/user/1/details/view

### Get the events of an order (Event Sourcing)
GET {{OrdersService_HostAddress}}/orders/1/events

### Rebuild the orders table from the events (Event Sourcing)
POST {{OrdersService_HostAddress}}/orders/projections/rebuild

### Health
GET {{OrdersService_HostAddress}}/health/orders

###

### Resilience patterns: only Retry on
PUT {{OrdersService_HostAddress}}/orders/patterns
Content-Type: application/json

{
  "retry": true,
  "circuitBreaker": false,
  "bulkhead": false,
  "throttling": false
}

### Resilience patterns: all on
DELETE {{OrdersService_HostAddress}}/orders/patterns
