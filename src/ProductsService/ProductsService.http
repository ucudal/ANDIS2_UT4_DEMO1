@ProductsService_HostAddress = http://localhost

### Create a product
POST {{ProductsService_HostAddress}}/products/
Content-Type: application/json

{
  "name": "Buzo",
  "price": 2300.00
}

### List all products
GET {{ProductsService_HostAddress}}/products/

### Get product by ID
GET {{ProductsService_HostAddress}}/products/1

###

### Update a product (invalidates the cache and publishes ProductUpdated)
PUT {{ProductsService_HostAddress}}/products/1
Content-Type: application/json

{
  "name": "Camisa de lino",
  "price": 1500.00
}

### Set the stock of a product (Saga: an inventory adjustment)
PUT {{ProductsService_HostAddress}}/products/1/stock
Content-Type: application/json

{
  "stock": 20
}

### Cache settings for the demos (Cache-Aside)
PUT {{ProductsService_HostAddress}}/products/cache
Content-Type: application/json

{
  "enabled": true,
  "dbDelayMs": 200
}

### Reset the cache settings
DELETE {{ProductsService_HostAddress}}/products/cache

###
