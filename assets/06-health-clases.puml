@startuml
!include PlantUML.style
hide empty members
hide circle
left to right direction
interface IHealthCheck <<interface>> {
  +CheckHealthAsync(context) : HealthCheckResult
}
interface IHealthCheckPublisher <<interface>> {
  +PublishAsync(report)
}
class RabbitMqHealthCheck {
  +CheckHealthAsync(context) : HealthCheckResult
}
class MongoHealthCheck {
  +CheckHealthAsync(context) : HealthCheckResult
}
class HealthMetricsPublisher {
  +PublishAsync(report)
  -Measurements()
}
class HealthResponse <<static>> {
  {static} +WriteJson(context, report)
}
class RabbitMq

RabbitMqHealthCheck ..|> IHealthCheck
MongoHealthCheck ..|> IHealthCheck
HealthMetricsPublisher ..|> IHealthCheckPublisher
RabbitMqHealthCheck --> RabbitMq

note bottom of HealthResponse : escribe el JSON de /health
note bottom of HealthMetricsPublisher : publica la métrica service_health
note top of IHealthCheck : las bases de Products y Orders usan\nAddDbContextCheck, que ya trae ASP.NET Core
@enduml
